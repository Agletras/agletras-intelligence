---
import { paths } from '@/lib/routes'

interface BusinessPillar {
  id: string
  code: string
  title: string
  subtitle: string
  badge: string
  color: string
  summary: string
  capabilities: string[]
  deliverable: string
}

const pillars: BusinessPillar[] = [
  {
    id: 'bi',
    code: 'PIL-01',
    title: 'Business Intelligence & Due Diligence',
    subtitle: 'Commercial Truth & Corporate Lineage',
    badge: 'CORPORATE OSINT',
    color: '#10b981',
    summary:
      'Hypothesis-driven commercial investigations uncovering opaque ownership structures, cross-border holding companies, undisclosed litigation, and nominee directors.',
    capabilities: [
      'Multi-jurisdictional corporate registry indexing',
      'Undisclosed beneficial ownership & nominee director graphing',
      'Supplier insolvency, sanction, and litigation exposure',
      'Cross-border corporate family reconstruction',
    ],
    deliverable: 'Executive Counterparty Intelligence Dossier with Attribution Citations',
  },
  {
    id: 'osint',
    code: 'PIL-02',
    title: 'Investigative OSINT & Asset Tracing',
    subtitle: 'Deep Open-Source Forensics',
    badge: 'INVESTIGATIVE OSINT',
    color: '#34d399',
    summary:
      'Connecting scattered public records across international registries, historical web archives, social signatures, and public disclosures to answer complex commercial questions.',
    capabilities: [
      'Hypothesis-driven OSINT investigation into entities and individuals',
      'Candidate & executive background verification with consent',
      'Historical digital footprint and breach exposure discovery',
      'Adversarial timeline reconstruction and public data linkage',
    ],
    deliverable: 'Forensic Evidence Register & Multi-Node Relationship Topology',
  },
  {
    id: 'cyber',
    code: 'PIL-03',
    title: 'Cyber Threat Intelligence & Attack Surface',
    subtitle: 'Passive External Perimeter Reconnaissance',
    badge: 'EXTERNAL THREAT OSINT',
    color: '#f59e0b',
    summary:
      '100% passive discovery of external attack surfaces, newly registered lookalike domains, expiring certificates, and adversary infrastructure staging.',
    capabilities: [
      'Real-time Certificate Transparency stream parsing',
      'Homoglyph and typo-squatting lookalike domain detection',
      'Unprotected staging host and dangling DNS record identification',
      'Adversary campaign staging monitoring and early alerting',
    ],
    deliverable: 'Brand Protection Risk Advisory & Machine-Readable STIX/JSON Feeds',
  },
]
---

<section class="topology-section" id="topology" data-section="03 // TOPOLOGY">
  <div class="grid-container">
    {/* Section Header */}
    <div class="topology-header-col reveal-on-scroll">
      <div class="eyebrow-badge">
        <span class="beacon-dot"></span>
        <span data-scramble="03 // CORE CAPABILITY ARCHITECTURE">03 // CORE CAPABILITY ARCHITECTURE</span>
      </div>

      <h2 class="section-title">
        The Tri-Pillar Intelligence Network.
      </h2>

      <p class="section-subtitle">
        Agletras bridges commercial investigations, deep open-source intelligence, and external cyber threat discovery through a unified analytical methodology.
      </p>
    </div>

    {/* Interactive Graph Canvas / Visual Stage */}
    <div class="topology-visual-col panel-telemetry reveal-on-scroll reveal-delay-1">
      <div class="topology-visual-header font-mono text-xs text-muted">
        <span>TOPOLOGY: TRI_PILLAR_SYNCHRONIZATION</span>
        <span class="text-emerald font-bold" id="topology-inspector-status">STATUS: STANDBY // HOVER TO INSPECT</span>
      </div>

      <div class="topology-canvas-container" id="canvas-container">
        <canvas id="tri-pillar-canvas" class="tri-pillar-canvas"></canvas>
        <div class="inspector-hint font-mono text-xs text-muted" aria-hidden="true">
          INTERACTIVE INSPECTOR // SELECT ANY PILLAR
        </div>
      </div>

      <div class="topology-legend font-mono text-xs">
        <div class="legend-item" data-legend-pillar="bi"><span class="legend-dot" style="background-color: #10b981;"></span> BI & DUE DILIGENCE</div>
        <div class="legend-item" data-legend-pillar="osint"><span class="legend-dot" style="background-color: #34d399;"></span> INVESTIGATIVE OSINT</div>
        <div class="legend-item" data-legend-pillar="cyber"><span class="legend-dot" style="background-color: #5eff88;"></span> THREAT INTEL & ATTACK SURFACE</div>
      </div>
    </div>

    {/* Interactive Pillar Cards */}
    <div class="topology-cards-col reveal-on-scroll reveal-delay-2">
      {pillars.map((pillar) => (
        <div class="pillar-card panel-telemetry" data-pillar-id={pillar.id} tabindex="0" role="region" aria-label={pillar.title}>
          <div class="pillar-card-meta font-mono text-xs">
            <span class="pillar-badge" style={`color: ${pillar.color}; border-color: ${pillar.color}40;`}>
              {pillar.badge}
            </span>
            <span class="pillar-code text-muted">{pillar.code}</span>
          </div>

          <h3 class="pillar-title font-display">{pillar.title}</h3>
          <p class="pillar-subtitle font-mono text-xs text-muted">{pillar.subtitle}</p>

          <p class="pillar-summary text-body-sm text-secondary">
            {pillar.summary}
          </p>

          <div class="pillar-capabilities">
            <span class="text-xs font-mono text-muted uppercase">Core Focus Areas:</span>
            <ul class="capability-list text-body-sm font-mono">
              {pillar.capabilities.map((cap) => (
                <li class="capability-item text-secondary">
                  <span class="bullet" style={`color: ${pillar.color};`}>›</span>
                  <span>{cap}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pillar-deliverable font-mono text-xs">
            <span class="text-muted">DELIVERABLE:</span>
            <span class="text-primary">{pillar.deliverable}</span>
          </div>

          <a href={paths.contact()} class="pillar-link font-mono text-xs" style={`color: ${pillar.color};`}>
            <span>Inquire About Discipline</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .topology-section {
    padding-top: 120px;
    padding-bottom: 120px;
    position: relative;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-hairline);
  }

  .topology-header-col {
    grid-column: span 32;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 56px;
  }

  .topology-visual-col {
    grid-column: span 12;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 580px;
    position: relative;
  }

  .topology-visual-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 12px;
    transition: color var(--transition-fast);
  }

  .topology-canvas-container {
    flex-grow: 1;
    position: relative;
    min-height: 420px;
    background: radial-gradient(circle at center, rgba(16, 185, 129, 0.06) 0%, transparent 70%);
    cursor: crosshair;
  }

  .inspector-hint {
    position: absolute;
    bottom: 10px;
    left: 12px;
    pointer-events: none;
    letter-spacing: 0.06em;
    font-size: 10px;
  }

  .tri-pillar-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .topology-legend {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border-hairline);
    padding-top: 16px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .legend-item.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .topology-cards-col {
    grid-column: span 20;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pillar-card {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    cursor: pointer;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .pillar-card:hover,
  .pillar-card.active,
  .pillar-card:focus-visible {
    transform: translateX(4px);
    border-color: rgba(16, 185, 129, 0.45);
    box-shadow: 0 4px 24px rgba(16, 185, 129, 0.12);
    outline: none;
  }

  .pillar-card[data-pillar-id="bi"].active {
    border-color: rgba(16, 185, 129, 0.7);
  }

  .pillar-card[data-pillar-id="osint"].active {
    border-color: rgba(52, 211, 153, 0.7);
  }

  .pillar-card[data-pillar-id="cyber"].active {
    border-color: rgba(94, 255, 136, 0.7);
  }

  .pillar-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pillar-badge {
    padding: 3px 8px;
    border: 1px solid;
    border-radius: 2px;
    font-weight: 600;
  }

  .pillar-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pillar-subtitle {
    letter-spacing: 0.06em;
  }

  .pillar-capabilities {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .capability-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
  }

  .capability-item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    line-height: 1.4;
  }

  .bullet {
    font-weight: 700;
  }

  .pillar-deliverable {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--border-hairline);
  }

  .pillar-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 8px;
    transition: transform var(--transition-fast);
  }

  .pillar-link:hover {
    transform: translateX(4px);
  }

  @media (max-width: 1280px) {
    .topology-visual-col {
      grid-column: span 32;
      min-height: 400px;
    }
    .topology-cards-col {
      grid-column: span 32;
    }
  }

  @media (max-width: 768px) {
    .capability-list {
      grid-template-columns: 1fr;
    }
    .pillar-card {
      padding: 20px;
    }
  }
</style>

<script>
  let topologyAnimId: number | null = null
  let topologyResizeHandler: (() => void) | null = null

  function initTriPillarCanvas() {
    if (topologyAnimId !== null) {
      cancelAnimationFrame(topologyAnimId)
      topologyAnimId = null
    }

    const canvas = document.getElementById('tri-pillar-canvas') as HTMLCanvasElement
    if (!canvas) return

    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    const resize = () => {
      canvas.width = canvas.clientWidth * dpr
      canvas.height = canvas.clientHeight * dpr
    }
    resize()

    if (topologyResizeHandler) {
      window.removeEventListener('resize', topologyResizeHandler)
    }
    topologyResizeHandler = resize
    window.addEventListener('resize', resize)

    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const statusEl = document.getElementById('topology-inspector-status')
    const cards = document.querySelectorAll<HTMLElement>('.pillar-card')
    const legendItems = document.querySelectorAll<HTMLElement>('.legend-item')

    let activePillarId: string | null = null
    let angle = 0

    // Particle streams traveling between center and nodes
    interface StreamParticle {
      pillarIndex: number
      progress: number
      speed: number
    }
    const streamParticles: StreamParticle[] = []
    for (let i = 0; i < 18; i++) {
      streamParticles.push({
        pillarIndex: i % 3,
        progress: Math.random(),
        speed: 0.008 + Math.random() * 0.012,
      })
    }

    const pillarDefs = [
      { id: 'bi', label: 'BI // DUE DILIGENCE', color: '#10b981', statusText: 'ACTIVE: PIL-01 CORPORATE LINEAGE' },
      { id: 'osint', label: 'INVESTIGATIVE OSINT', color: '#34d399', statusText: 'ACTIVE: PIL-02 FORENSIC EVIDENCE' },
      { id: 'cyber', label: 'CYBER THREAT OSINT', color: '#5eff88', statusText: 'ACTIVE: PIL-03 PERIMETER STAGING' },
    ]

    function setActivePillar(id: string | null) {
      activePillarId = id
      cards.forEach((c) => {
        if (c.dataset.pillarId === id) {
          c.classList.add('active')
        } else {
          c.classList.remove('active')
        }
      })
      legendItems.forEach((item) => {
        if (item.dataset.legendPillar === id) {
          item.classList.add('active')
        } else {
          item.classList.remove('active')
        }
      })

      if (statusEl) {
        if (id) {
          const def = pillarDefs.find((d) => d.id === id)
          statusEl.textContent = def ? `[${def.statusText}]` : 'STATUS: STREAM_INSPECTED'
          statusEl.style.color = def ? def.color : 'var(--accent-emerald)'
        } else {
          statusEl.textContent = 'STATUS: STANDBY // HOVER TO INSPECT'
          statusEl.style.color = 'var(--accent-emerald)'
        }
      }
    }

    // Card hover & click listeners
    cards.forEach((card) => {
      const id = card.dataset.pillarId || null
      card.addEventListener('mouseenter', () => setActivePillar(id))
      card.addEventListener('focus', () => setActivePillar(id))
      card.addEventListener('mouseleave', () => setActivePillar(null))
      card.addEventListener('blur', () => setActivePillar(null))
      card.addEventListener('click', () => {
        if (activePillarId === id) {
          setActivePillar(null)
        } else {
          setActivePillar(id)
        }
      })
    })

    // Canvas click & hover hit testing
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect()
      const mx = (e.clientX - rect.left) * dpr
      const my = (e.clientY - rect.top) * dpr

      const cx = canvas.width / 2
      const cy = canvas.height / 2
      const radius = Math.min(cx, cy) * 0.65

      let hovered: string | null = null
      for (let i = 0; i < 3; i++) {
        const theta = angle + (Math.PI * 2 * i) / 3
        const nx = cx + Math.cos(theta) * radius
        const ny = cy + Math.sin(theta) * radius * 0.85
        const dist = Math.hypot(mx - nx, my - ny)
        if (dist < 35 * dpr) {
          hovered = pillarDefs[i]?.id || null
          break
        }
      }
      if (hovered !== activePillarId) {
        setActivePillar(hovered)
      }
    })

    canvas.addEventListener('mouseleave', () => {
      setActivePillar(null)
    })

    function animate() {
      if (!ctx) return
      ctx.clearRect(0, 0, canvas.width, canvas.height)

      const cx = canvas.width / 2
      const cy = canvas.height / 2
      const radius = Math.min(cx, cy) * 0.65

      // Pillar Nodes Coordinates
      const currentNodes = pillarDefs.map((def, i) => {
        const theta = angle + (Math.PI * 2 * i) / 3
        return {
          id: def.id,
          x: cx + Math.cos(theta) * radius,
          y: cy + Math.sin(theta) * radius * 0.85,
          color: def.color,
          label: def.label,
          isActive: def.id === activePillarId,
        }
      })

      // Draw Triangular Connecting Perimeter
      const n0 = currentNodes[0]
      const n1 = currentNodes[1]
      const n2 = currentNodes[2]
      if (n0 && n1 && n2) {
        ctx.lineWidth = 1.5
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)'
        ctx.beginPath()
        ctx.moveTo(n0.x, n0.y)
        ctx.lineTo(n1.x, n1.y)
        ctx.lineTo(n2.x, n2.y)
        ctx.closePath()
        ctx.stroke()
      }

      // Center Core Hub: Agletras Epistemic Engine
      ctx.fillStyle = '#ffffff'
      ctx.beginPath()
      ctx.arc(cx, cy, 6 * dpr, 0, Math.PI * 2)
      ctx.fill()

      ctx.strokeStyle = 'rgba(16, 185, 129, 0.4)'
      ctx.lineWidth = 1.5
      ctx.beginPath()
      ctx.arc(cx, cy, 14 * dpr, 0, Math.PI * 2)
      ctx.stroke()

      // Label for center hub
      ctx.font = `${Math.floor(8 * dpr)}px monospace`
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)'
      ctx.textAlign = 'center'
      ctx.fillText('AGLETRAS CORE', cx, cy - 20 * dpr)

      // Draw Radial Lines, Stream Packets, and Pillars
      currentNodes.forEach((node) => {
        const isHighlight = node.isActive || !activePillarId

        // Radial line
        ctx.strokeStyle = node.isActive ? node.color : `${node.color}35`
        ctx.lineWidth = node.isActive ? 2.5 : 1
        ctx.beginPath()
        ctx.moveTo(cx, cy)
        ctx.lineTo(node.x, node.y)
        ctx.stroke()

        // Satellite Micro-Nodes if active
        if (node.isActive) {
          for (let s = 0; s < 3; s++) {
            const satAngle = (s * Math.PI * 2) / 3 + angle * 2
            const sx = node.x + Math.cos(satAngle) * 26 * dpr
            const sy = node.y + Math.sin(satAngle) * 26 * dpr
            ctx.fillStyle = node.color
            ctx.beginPath()
            ctx.arc(sx, sy, 2.5 * dpr, 0, Math.PI * 2)
            ctx.fill()

            ctx.strokeStyle = `${node.color}50`
            ctx.lineWidth = 1
            ctx.beginPath()
            ctx.moveTo(node.x, node.y)
            ctx.lineTo(sx, sy)
            ctx.stroke()
          }
        }

        // Draw Pillar Node Circle
        ctx.fillStyle = node.color
        ctx.beginPath()
        ctx.arc(node.x, node.y, (node.isActive ? 11 : 7) * dpr, 0, Math.PI * 2)
        ctx.fill()

        // Outer Glow Ring
        ctx.strokeStyle = node.isActive ? '#ffffff' : `${node.color}80`
        ctx.lineWidth = node.isActive ? 2 : 1
        ctx.beginPath()
        ctx.arc(node.x, node.y, (node.isActive ? 18 : 12) * dpr, 0, Math.PI * 2)
        ctx.stroke()

        // Text label
        ctx.font = `${Math.floor(9 * dpr)}px monospace`
        ctx.fillStyle = isHighlight ? '#ffffff' : 'rgba(255, 255, 255, 0.4)'
        ctx.textAlign = 'center'
        ctx.fillText(node.label, node.x, node.y + 24 * dpr)
      })

      // Draw Traveling Stream Packets
      streamParticles.forEach((sp) => {
        const targetNode = currentNodes[sp.pillarIndex]
        if (!targetNode) return

        sp.progress += sp.speed * (targetNode.isActive ? 2 : 1)
        if (sp.progress > 1) sp.progress = 0

        const px = cx + (targetNode.x - cx) * sp.progress
        const py = cy + (targetNode.y - cy) * sp.progress

        ctx.fillStyle = targetNode.color
        ctx.globalAlpha = targetNode.isActive ? 0.95 : 0.6
        ctx.beginPath()
        ctx.arc(px, py, (targetNode.isActive ? 3.5 : 2) * dpr, 0, Math.PI * 2)
        ctx.fill()
        ctx.globalAlpha = 1
      })

      if (!prefersReducedMotion) {
        angle += 0.003
        topologyAnimId = requestAnimationFrame(animate)
      }
    }

    topologyAnimId = requestAnimationFrame(animate)

    document.addEventListener('astro:before-swap', () => {
      if (topologyAnimId !== null) {
        cancelAnimationFrame(topologyAnimId)
        topologyAnimId = null
      }
      if (topologyResizeHandler) {
        window.removeEventListener('resize', topologyResizeHandler)
        topologyResizeHandler = null
      }
    })
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTriPillarCanvas)
  } else {
    initTriPillarCanvas()
  }

  document.addEventListener('astro:page-load', initTriPillarCanvas)
</script>
