  <span class="json-key">"jsonrpc"</span>: <span class="json-str">"2.0"</span>,
  <span class="json-key">"id"</span>: <span class="json-num">104</span>,
  <span class="json-key">"method"</span>: <span class="json-str">"tools/call"</span>,
  <span class="json-key">"params"</span>: &#123;
    <span class="json-key">"name"</span>: <span class="json-str">"verify_claims"</span>,
    <span class="json-key">"arguments"</span>: &#123;
      <span class="json-key">"run_id"</span>: <span class="json-num">1</span>,
      <span class="json-key">"claim_ids"</span>: [<span class="json-num">42</span>],
      <span class="json-key">"method"</span>: <span class="json-str">"deterministic"</span>
    &#125;
  &#125;
&#125;</code></pre>
        </div>

        <div class="contract-block">
          <div class="contract-header font-mono text-xs">
            <span class="text-emerald font-bold">&lt; AGLETRAS MCP SERVER RESPONSE (STDOUT):</span>
            <span class="text-muted">STATUS: 200 OK (STDIO FRAME)</span>
          </div>
          <pre class="contract-pre font-mono text-xs"><code>&#123;
  <span class="json-key">"jsonrpc"</span>: <span class="json-str">"2.0"</span>,
  <span class="json-key">"id"</span>: <span class="json-num">104</span>,
  <span class="json-key">"result"</span>: &#123;
    <span class="json-key">"run_id"</span>: <span class="json-num">1</span>,
    <span class="json-key">"verifications_evaluated"</span>: <span class="json-num">1</span>,
    <span class="json-key">"claims"</span>: [
      &#123;
        <span class="json-key">"claim_id"</span>: <span class="json-num">42</span>,
        <span class="json-key">"claim_text"</span>: <span class="json-str">"Registered corporate office located in Nashik, Maharashtra, PIN 422003"</span>,
        <span class="json-key">"epistemic_status"</span>: <span class="json-str text-emerald">"SUPPORTED"</span>,
        <span class="json-key">"matched_passage_id"</span>: <span class="json-num">12</span>,
        <span class="json-key">"term_coverage"</span>: <span class="json-num">0.94</span>,
        <span class="json-key">"exact_quote_match"</span>: <span class="json-bool">true</span>,
        <span class="json-key">"source_locator"</span>: <span class="json-str">"page 3, sec: Statutory Registration"</span>,
        <span class="json-key">"sha256"</span>: <span class="json-str">"4b2f8a19c3e218e87d0921473fa0081d6..."</span>
      &#125;
    ],
    <span class="json-key">"unresolved_conflicts_surfaced"</span>: <span class="json-num">0</span>
  &#125;
&#125;</code></pre>
        </div>
      </div>
    </div>
  </div>

  <!-- Terminal Footer Indicator -->
  <div class="terminal-footer font-mono text-xs text-muted">
    <div class="footer-left">
      <span class="beacon-dot"></span>
      <span>SIMULATED PIPELINE TELEMETRY: Demonstrates 40 registered MCP tools â€¢ Connect locally via stdio JSON-RPC for live execution</span>
    </div>
    <div class="footer-right">
      <span>Zero Mandatory Paid APIs for Core Operation</span>
    </div>
  </div>
</div>

<script>
  /**
   * Terminal Simulator Continuous Pipeline Engine
   *
   * Features:
   * 1. Auto-starts when terminal enters viewport via IntersectionObserver.
   * 2. Progressively animates 11 log entries one-by-one across 5 stages.
   * 3. Continuously updates elapsed timestamps from current cycle clock.
   * 4. Dynamically synchronizes 5 stage indicators (is-active, is-completed).
   * 5. When stage 5 completes, pauses briefly (2.5s) and restarts loop smoothly.
   * 6. Interactive controls:
   *    - Pause/Resume: toggles simulation state, halts/resumes timers seamlessly.
   *    - Replay: resets immediately and plays from stage 1.
   * 7. Tab isolation: pauses when user navigates away from 'tab-trace', resumes on return.
   * 8. Visibility & viewport management: pauses on hidden tab or out-of-view scroll.
   * 9. Reduced motion: displays static completed state with zero animation loops.
   */

  interface StepConfig {
    stageIndex: number // 0 to 4
    lineIndex: number  // 0 to 10
    delay: number      // ms delay from previous event
  }

  const STEPS: StepConfig[] = [
    // Stage 1: Query & Bound (Block 0)
    { stageIndex: 0, lineIndex: 0, delay: 0 },
    { stageIndex: 0, lineIndex: 1, delay: 650 },
    // Stage 2: Source Ingestion (Block 1)
    { stageIndex: 1, lineIndex: 2, delay: 750 },
    { stageIndex: 1, lineIndex: 3, delay: 800 },
    // Stage 3: Passage Indexing (Block 2)
    { stageIndex: 2, lineIndex: 4, delay: 850 },
    // Stage 4: Claim Verification (Block 3)
    { stageIndex: 3, lineIndex: 5, delay: 850 },
    { stageIndex: 3, lineIndex: 6, delay: 600 },
    { stageIndex: 3, lineIndex: 7, delay: 600 },
    { stageIndex: 3, lineIndex: 8, delay: 600 },
    // Stage 5: Report Delivery (Block 4)
    { stageIndex: 4, lineIndex: 9, delay: 750 },
    { stageIndex: 4, lineIndex: 10, delay: 650 },
  ]

  const STAGE_COMPLETE_DELAY = 650
  const LOOP_RESTART_DELAY = 2500

  let cleanupTerminalSimulation: (() => void) | null = null

  function initTerminalSimulation() {
    if (cleanupTerminalSimulation) {
      cleanupTerminalSimulation()
      cleanupTerminalSimulation = null
    }

    const terminalCard = document.querySelector<HTMLElement>('.terminal-card')
    if (!terminalCard) return

    // Tab buttons and panels
    const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.sim-tab-btn'))
    const tabPanels = document.querySelectorAll<HTMLElement>('.sim-panel')

    // Pipeline elements
    const stepIndicators = Array.from(document.querySelectorAll<HTMLElement>('.trace-step-indicator'))
    const stageBlocks = Array.from(document.querySelectorAll<HTMLElement>('.trace-stage-block'))
    const logLines = Array.from(document.querySelectorAll<HTMLElement>('#tab-trace .log-line'))
    const replayBtn = document.getElementById('btn-replay-trace') as HTMLButtonElement | null
    const pauseBtn = document.getElementById('btn-pause-trace') as HTMLButtonElement | null
    const pauseBtnLabel = document.getElementById('pause-btn-label')
    const pauseBtnIcon = pauseBtn?.querySelector<HTMLElement>('.ctrl-icon')
    const simLiveIndicator = document.getElementById('sim-live-indicator')
    const simLiveText = document.getElementById('sim-live-text')

    // Mark as simulating for progressive CSS enhancement
    terminalCard.classList.add('is-simulating')

    // Motion preference check
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    if (prefersReducedMotion.matches) {
      logLines.forEach(l => l.classList.add('is-visible'))
      stageBlocks.forEach(b => b.classList.add('is-revealed'))
      stepIndicators.forEach(ind => {
        ind.classList.remove('is-active')
        ind.classList.add('is-completed')
      })
      if (simLiveText) simLiveText.textContent = 'SIMULATION COMPLETE'
      if (pauseBtn) {
        pauseBtn.disabled = true
        pauseBtn.style.opacity = '0.5'
        pauseBtn.style.cursor = 'default'
      }
      return
    }

    // State
    let currentStepIndex = -1
    let isUserPaused = false
    let isInternalPaused = true // Starts paused until viewport observer triggers
    let isVisibleInViewport = false
    let isPageVisible = !document.hidden
    let isTraceTabActive = true

    let activeTimerId: number | null = null
    let stepStartTime = 0
    let stepRemainingDelay = 0

    let cycleActiveElapsed = 0
    let lastResumeTime = 0

    function getCycleElapsed(): number {
      if (isUserPaused || isInternalPaused) {
        return cycleActiveElapsed
      }
      return cycleActiveElapsed + (Date.now() - lastResumeTime)
    }

    function formatElapsed(ms: number): string {
      const totalSeconds = (ms + 80) / 1000
      const minutes = Math.floor(totalSeconds / 60)
      const seconds = totalSeconds % 60
      const minStr = String(minutes).padStart(2, '0')
      const secStr = seconds.toFixed(2).padStart(5, '0')
      return `[${minStr}:${secStr}]`
    }

    function clearTimer() {
      if (activeTimerId !== null) {
        clearTimeout(activeTimerId)
        activeTimerId = null
      }
    }

    function updateStageIndicators(activeStageIdx: number) {
      stepIndicators.forEach((ind, i) => {
        ind.classList.remove('is-active', 'is-completed')
        if (i < activeStageIdx) {
          ind.classList.add('is-completed')
        } else if (i === activeStageIdx) {
          ind.classList.add('is-active')
        }
      })
    }

    function markAllStagesCompleted() {
      stepIndicators.forEach(ind => {
        ind.classList.remove('is-active')
        ind.classList.add('is-completed')
      })
    }

    function updateControlsUI() {
      if (isUserPaused) {
        pauseBtn?.classList.add('is-paused')
        pauseBtn?.setAttribute('aria-label', 'Resume continuous simulated trace animation')
        if (pauseBtn) pauseBtn.title = 'Resume continuous simulation'
        if (pauseBtnLabel) pauseBtnLabel.textContent = 'Resume'
        if (pauseBtnIcon) pauseBtnIcon.innerHTML = '&#x25b6;' // Play

        simLiveIndicator?.classList.add('is-paused')
        if (simLiveText) simLiveText.textContent = 'SIMULATION PAUSED'
      } else {
        pauseBtn?.classList.remove('is-paused')
        pauseBtn?.setAttribute('aria-label', 'Pause continuous simulated trace animation')
        if (pauseBtn) pauseBtn.title = 'Pause continuous simulation'
        if (pauseBtnLabel) pauseBtnLabel.textContent = 'Pause'
        if (pauseBtnIcon) pauseBtnIcon.innerHTML = '&#x23f8;' // Pause

        simLiveIndicator?.classList.remove('is-paused')
        if (simLiveText) simLiveText.textContent = 'LIVE SIMULATION'
      }
    }

    function applyStep(index: number) {
      const step = STEPS[index]
      if (!step) return

      updateStageIndicators(step.stageIndex)
      stageBlocks[step.stageIndex]?.classList.add('is-revealed')

      const line = logLines[step.lineIndex]
      if (line) {
        line.classList.add('is-visible')
        const tsEl = line.querySelector<HTMLElement>('.log-ts')
        if (tsEl) {
          tsEl.textContent = formatElapsed(getCycleElapsed())
        }
      }
    }

    function scheduleStep(delay: number) {
      clearTimer()
      stepRemainingDelay = delay
      stepStartTime = Date.now()
      activeTimerId = window.setTimeout(() => {
        activeTimerId = null
        stepRemainingDelay = 0
        stepStartTime = 0
        advanceStep()
      }, delay)
    }

    function advanceStep() {
      currentStepIndex++

      if (currentStepIndex < STEPS.length) {
        applyStep(currentStepIndex)
        const nextIndex = currentStepIndex + 1
        const nextStep = STEPS[nextIndex]
        if (nextStep) {
          scheduleStep(nextStep.delay)
        } else {
          scheduleStep(STAGE_COMPLETE_DELAY)
        }
      } else if (currentStepIndex === STEPS.length) {
        markAllStagesCompleted()
        scheduleStep(LOOP_RESTART_DELAY)
      } else {
        // Reset and loop
        startCycle()
      }
    }

    function resetDOM() {
      logLines.forEach(l => l.classList.remove('is-visible'))
      stageBlocks.forEach(b => b.classList.remove('is-revealed'))
      stepIndicators.forEach((ind, i) => {
        ind.classList.remove('is-active', 'is-completed')
        if (i === 0) ind.classList.add('is-active')
      })
    }

    function startCycle() {
      clearTimer()
      currentStepIndex = -1
      cycleActiveElapsed = 0
      lastResumeTime = Date.now()
      resetDOM()
      const firstStep = STEPS[0]
      scheduleStep(firstStep ? firstStep.delay : 0)
    }

    function pause(byUser = false) {
      if (byUser) isUserPaused = true
      if (isInternalPaused && !byUser) return
      isInternalPaused = true

      if (activeTimerId !== null) {
        clearTimer()
        const elapsed = Date.now() - stepStartTime
        stepRemainingDelay = Math.max(0, stepRemainingDelay - elapsed)
      }

      cycleActiveElapsed += Math.max(0, Date.now() - lastResumeTime)
      lastResumeTime = Date.now()
      updateControlsUI()
    }

    function resume(byUser = false) {
      if (byUser) isUserPaused = false
      if (isUserPaused || !isVisibleInViewport || !isPageVisible || !isTraceTabActive) {
        updateControlsUI()
        return
      }

      isInternalPaused = false
      lastResumeTime = Date.now()
      updateControlsUI()

      if (currentStepIndex < 0) {
        startCycle()
        return
      }

      const delay = stepRemainingDelay > 0 ? stepRemainingDelay : 100
      scheduleStep(delay)
    }

    function replay() {
      isUserPaused = false
      isInternalPaused = false
      updateControlsUI()
      startCycle()
    }

    // Tab switcher with WAI-ARIA
    function activateTab(btn: HTMLButtonElement) {
      const targetId = btn.getAttribute('data-target')
      if (!targetId) return

      tabButtons.forEach(b => {
        b.classList.remove('is-active')
        b.setAttribute('aria-selected', 'false')
        b.tabIndex = -1
      })
      tabPanels.forEach(p => {
        p.classList.remove('is-active')
        p.hidden = true
      })

      btn.classList.add('is-active')
      btn.setAttribute('aria-selected', 'true')
      btn.tabIndex = 0
      btn.focus()
      const targetPanel = document.getElementById(targetId)
      if (targetPanel) {
        targetPanel.classList.add('is-active')
        targetPanel.hidden = false
      }

      const wasTraceActive = isTraceTabActive
      isTraceTabActive = (targetId === 'tab-trace')

      if (isTraceTabActive && !wasTraceActive) {
        resume(false)
      } else if (!isTraceTabActive && wasTraceActive) {
        pause(false)
      }
    }

    const tabListeners: Array<{ el: HTMLElement; type: string; fn: any }> = []

    tabButtons.forEach((btn, index) => {
      const clickHandler = () => activateTab(btn)
      const keyHandler = (e: KeyboardEvent) => {
        let targetIndex: number | null = null
        if (e.key === 'ArrowRight') {
          targetIndex = (index + 1) % tabButtons.length
        } else if (e.key === 'ArrowLeft') {
          targetIndex = (index - 1 + tabButtons.length) % tabButtons.length
        } else if (e.key === 'Home') {
          targetIndex = 0
        } else if (e.key === 'End') {
          targetIndex = tabButtons.length - 1
        }
        if (targetIndex !== null) {
          const nextBtn = tabButtons[targetIndex]
          if (nextBtn) {
            e.preventDefault()
            activateTab(nextBtn)
          }
        }
      }
      btn.addEventListener('click', clickHandler)
      btn.addEventListener('keydown', keyHandler)
      tabListeners.push({ el: btn, type: 'click', fn: clickHandler })
      tabListeners.push({ el: btn, type: 'keydown', fn: keyHandler })
    })

    // Control buttons
    const pauseHandler = () => {
      if (isUserPaused) {
        resume(true)
      } else {
        pause(true)
      }
    }
    pauseBtn?.addEventListener('click', pauseHandler)

    const replayHandler = () => {
      replay()
    }
    replayBtn?.addEventListener('click', replayHandler)

    // Visibility change
    const visibilityHandler = () => {
      isPageVisible = !document.hidden
      if (isPageVisible) {
        resume(false)
      } else {
        pause(false)
      }
    }
    document.addEventListener('visibilitychange', visibilityHandler)

    // Viewport IntersectionObserver
    let observer: IntersectionObserver | null = null
    if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isVisibleInViewport = entry.isIntersecting
          if (isVisibleInViewport) {
            resume(false)
          } else {
            pause(false)
          }
        })
      }, { threshold: 0.10 })
      observer.observe(terminalCard)
    } else {
      isVisibleInViewport = true
      resume(false)
    }

    // Cleanup reference
    cleanupTerminalSimulation = () => {
      clearTimer()
      if (observer) {
        observer.disconnect()
        observer = null
      }
      document.removeEventListener('visibilitychange', visibilityHandler)
      pauseBtn?.removeEventListener('click', pauseHandler)
      replayBtn?.removeEventListener('click', replayHandler)
      tabListeners.forEach(({ el, type, fn }) => el.removeEventListener(type, fn))
    }
  }

  // Self-mount on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminalSimulation)
  } else {
    initTerminalSimulation()
  }

  // ClientRouter lifecycle
  document.addEventListener('astro:page-load', initTerminalSimulation)
  document.addEventListener('astro:before-swap', () => {
    if (cleanupTerminalSimulation) {
      cleanupTerminalSimulation()
      cleanupTerminalSimulation = null
    }
  })
</script>

