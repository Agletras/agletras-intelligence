          <span class="text-primary">64 content-addressed passages saved to SQLite with character offsets, SHA-256 hashes &amp; page locators</span>
        </div>
      </div>

      <div class="trace-stage-block" data-stage="4">
        <div class="log-line log-divider">
          <span class="log-ts text-dim">[00:03.80]</span>
          <span class="log-tag text-emerald font-bold">VERIFY</span>
          <span class="text-primary">verify_claims() -&gt; Evaluating claims against exact stored passage text:</span>
        </div>
        <div class="log-line log-indent">
          <span class="log-bullet text-emerald">â”œâ”€ [F1]</span>
          <span class="text-secondary">Claim: 'Registered office located in Nashik, Maharashtra, PIN 422003'</span>
          <span class="badge-status status-supported font-bold">SUPPORTED</span>
          <span class="text-dim">(Passage #12: 94% term match)</span>
        </div>
        <div class="log-line log-indent">
          <span class="log-bullet text-amber">â”œâ”€ [F2]</span>
          <span class="text-secondary">Claim: 'Reported $12M Series A funding in Q3 2024'</span>
          <span class="badge-status status-conflict font-bold">CONFLICTING EVIDENCE</span>
          <span class="text-dim">(Passage #19 vs #41)</span>
        </div>
        <div class="log-line log-indent">
          <span class="log-bullet text-muted">â””â”€ [F3]</span>
          <span class="text-secondary">Claim: 'Unattributed market dominance claim'</span>
          <span class="badge-status status-unverified font-bold">UNVERIFIED</span>
          <span class="text-dim">(Coverage: 18%, 0 citations attached)</span>
        </div>
      </div>

      <div class="trace-stage-block" data-stage="5">
        <div class="log-line">
          <span class="log-ts text-dim">[00:04.90]</span>
          <span class="log-tag text-emerald font-bold">REPORT</span>
          <span class="text-primary">generate_markdown_report() + generate_client_report() -&gt; 10-section report &amp; DOCX created</span>
        </div>
        <div class="log-line">
          <span class="log-ts text-dim">[00:05.42]</span>
          <span class="log-tag text-emerald font-bold">VALIDATE</span>
