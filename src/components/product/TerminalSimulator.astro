---
// TerminalSimulator.astro - Interactive terminal-style research demonstration
// Clearly labeled as a simulated demonstration of the actual Agletras MCP pipeline
---

<div class="terminal-card panel-telemetry">
  <!-- Terminal Title Bar -->
  <div class="terminal-header">
    <div class="window-controls" aria-hidden="true">
      <span class="ctrl-dot dot-red"></span>
      <span class="ctrl-dot dot-yellow"></span>
      <span class="ctrl-dot dot-green"></span>
    </div>

    <div class="terminal-title font-mono text-xs text-muted">
      <span class="title-full">agletras-terminal — run_id: 1 [Target: Corporate Lineage & Funding]</span>
      <span class="title-short">agletras</span>
    </div>

    <div class="terminal-badge font-mono text-xs">
      <span class="beacon-dot"></span>
      <span class="text-amber font-bold">[SIMULATED WALKTHROUGH]</span>
      <span class="text-dim">|</span>
      <span class="text-emerald">STDIO // WAL</span>
    </div>
  </div>

  <!-- Simulation Notice & Live Execution Distinction -->
  <div class="simulation-banner font-mono text-xs">
    <div class="sim-banner-row">
      <span class="text-amber font-bold">[SIMULATED TELEMETRY // DEMO PRESET]</span>
      <span class="sim-live-badge text-emerald font-bold">LIVE SYSTEM: LOCAL STDIO PROTOCOL</span>
    </div>
    <span class="text-muted leading-relaxed">
      This walkthrough displays deterministic pre-recorded execution traces from our hermetic test suite demonstrating the 5-stage pipeline. Live research runs locally on your machine via <code>python -m agletras_mcp</code> over standard I/O; evidence remains in your local SQLite store with zero telemetry or analytical data sent to Agletras or external AI platforms. Outbound network requests are limited to target URLs governed by local NetPolicy SSRF guards.
    </span>
  </div>

  <!-- View Switcher Tabs -->
  <div class="terminal-nav" role="tablist" aria-label="Terminal views">
    <button 
      type="button" 
      class="sim-tab-btn is-active text-xs" 
      data-target="tab-trace"
      role="tab"
      aria-selected="true"
      aria-controls="tab-trace"
      id="tab-btn-trace"
    >
      <span class="tab-label-full">01. Agent Execution Trace</span>
      <span class="tab-label-short">01 Trace</span>
    </button>
    <button 
      type="button" 
      class="sim-tab-btn text-xs" 
      data-target="tab-passages"
      role="tab"
      aria-selected="false"
      aria-controls="tab-passages"
      id="tab-btn-passages"
    >
      <span class="tab-label-full">02. Passage Evidence Graph</span>
      <span class="tab-label-short">02 Evidence</span>
    </button>
    <button 
      type="button" 
      class="sim-tab-btn text-xs" 
      data-target="tab-synthesis"
      role="tab"
      aria-selected="false"
      aria-controls="tab-synthesis"
      id="tab-btn-synthesis"
    >
      <span class="tab-label-full">03. Validated Synthesis</span>
      <span class="tab-label-short">03 Synthesis</span>
    </button>
    <button 
      type="button" 
      class="sim-tab-btn text-xs" 
      data-target="tab-protocol"
      role="tab"
      aria-selected="false"
      aria-controls="tab-protocol"
      id="tab-btn-protocol"
    >
      <span class="tab-label-full">04. JSON-RPC Protocol Contract</span>
      <span class="tab-label-short">04 Protocol</span>
    </button>
  </div>

  <!-- Terminal Content Body -->
  <div class="terminal-body font-mono text-xs">
    <!-- Panel 1: Execution Trace -->
    <div class="sim-panel is-active" id="tab-trace" role="tabpanel" aria-labelledby="tab-btn-trace">
      <!-- Sequential Pipeline Stage Indicator -->
      <div class="trace-workflow-strip font-mono text-xs" aria-label="Simulated workflow sequence">
        <span class="workflow-label text-dim">SIMULATED STAGE:</span>
        <div class="trace-step-indicator is-active" data-step="1">
          <span class="step-num font-bold">01</span>
          <span class="step-label">Query &amp; Bound</span>
        </div>
        <span class="step-arrow" aria-hidden="true">&rarr;</span>
        <div class="trace-step-indicator" data-step="2">
          <span class="step-num font-bold">02</span>
          <span class="step-label">Source Ingestion</span>
        </div>
        <span class="step-arrow" aria-hidden="true">&rarr;</span>
        <div class="trace-step-indicator" data-step="3">
          <span class="step-num font-bold">03</span>
          <span class="step-label">Passage Indexing</span>
        </div>
        <span class="step-arrow" aria-hidden="true">&rarr;</span>
        <div class="trace-step-indicator" data-step="4">
          <span class="step-num font-bold">04</span>
          <span class="step-label">Claim Verification</span>
        </div>
        <span class="step-arrow" aria-hidden="true">&rarr;</span>
        <div class="trace-step-indicator" data-step="5">
          <span class="step-num font-bold">05</span>
          <span class="step-label">Report Delivery</span>
        </div>

        <button type="button" class="btn-replay-trace" id="btn-replay-trace" aria-label="Replay simulated trace sequence" title="Replay simulated trace animation">
          <span class="replay-icon" aria-hidden="true">&#x21bb;</span>
          <span class="replay-label">Replay</span>
        </button>
      </div>

      <div class="trace-stage-block" data-stage="1">
        <div class="log-line text-muted">
          <span class="log-ts text-dim">[00:00.08]</span>
          <span class="log-tag text-emerald font-bold">INIT</span>
          <span>Agletras MCP Server v0.2.0 active (transport: stdio, 40 registered tools)</span>
        </div>
        <div class="log-line">
          <span class="log-ts text-dim">[00:00.64]</span>
          <span class="log-tag text-emerald font-bold">PLAN</span>
          <span class="text-primary">save_research_plan() -&gt; 4 subquestions formulated. Budget cap: 8 questions, 2 rounds, 20 unique sources.</span>
        </div>
      </div>

      <div class="trace-stage-block" data-stage="2">
        <div class="log-line">
          <span class="log-ts text-dim">[00:01.32]</span>
          <span class="log-tag text-cyan font-bold">SEARCH</span>
          <span class="text-secondary">search_web(query='Target Entity ownership filings Maharashtra') -&gt; 4 candidate URLs returned</span>
        </div>
        <div class="log-line">
          <span class="log-ts text-dim">[00:02.15]</span>
          <span class="log-tag text-cyan font-bold">INGEST</span>
          <span class="text-secondary">collect_sources(sources=4, include_text=true) -&gt; SSRF check: 4/4 PASS (RFC1918 blocked)</span>
        </div>
      </div>

      <div class="trace-stage-block" data-stage="3">
        <div class="log-line">
          <span class="log-ts text-dim">[00:02.98]</span>
          <span class="log-tag text-emerald font-bold">INDEX</span>
          <span class="text-primary">64 content-addressed passages saved to SQLite with character offsets, SHA-256 hashes &amp; page locators</span>
        </div>
      </div>

      <div class="trace-stage-block" data-stage="4">
        <div class="log-line log-divider">
          <span class="log-ts text-dim">[00:03.80]</span>
          <span class="log-tag text-emerald font-bold">VERIFY</span>
          <span class="text-primary">verify_claims() -&gt; Evaluating claims against exact stored passage text:</span>
        </div>
        <div class="log-line log-indent">
          <span class="log-bullet text-emerald">├─ [F1]</span>
          <span class="text-secondary">Claim: 'Registered office located in Nashik, Maharashtra, PIN 422003'</span>
          <span class="badge-status status-supported font-bold">SUPPORTED</span>
          <span class="text-dim">(Passage #12: 94% term match)</span>
        </div>
        <div class="log-line log-indent">
          <span class="log-bullet text-amber">├─ [F2]</span>
          <span class="text-secondary">Claim: 'Reported $12M Series A funding in Q3 2024'</span>
          <span class="badge-status status-conflict font-bold">CONFLICTING EVIDENCE</span>
          <span class="text-dim">(Passage #19 vs #41)</span>
        </div>
        <div class="log-line log-indent">
          <span class="log-bullet text-muted">└─ [F3]</span>
          <span class="text-secondary">Claim: 'Unattributed market dominance claim'</span>
          <span class="badge-status status-unverified font-bold">UNVERIFIED</span>
          <span class="text-dim">(Coverage: 18%, 0 citations attached)</span>
        </div>
      </div>

      <div class="trace-stage-block" data-stage="5">
        <div class="log-line">
          <span class="log-ts text-dim">[00:04.90]</span>
          <span class="log-tag text-emerald font-bold">REPORT</span>
          <span class="text-primary">generate_markdown_report() + generate_client_report() -&gt; 10-section report &amp; DOCX created</span>
        </div>
        <div class="log-line">
          <span class="log-ts text-dim">[00:05.42]</span>
          <span class="log-tag text-emerald font-bold">VALIDATE</span>
          <span class="text-emerald font-bold">validate_report() -&gt; STRUCTURAL INTEGRITY PASSED (0 dangling citations, hashes intact)</span>
        </div>
      </div>
    </div>

    <!-- Panel 2: Passage Evidence Graph -->
    <div class="sim-panel" id="tab-passages" role="tabpanel" aria-labelledby="tab-btn-passages" hidden>
      <div class="json-block">
        <span class="json-comment">// Content-addressed passage slice in SQLite (FTS5 indexed, SHA-256 hashed)</span>
        <span class="json-brace">&#123;</span>
        <div class="json-row"><span class="json-key">"passage_id"</span>: <span class="json-num">12</span>,</div>
        <div class="json-row"><span class="json-key">"source_id"</span>: <span class="json-num">1</span>,</div>
        <div class="json-row"><span class="json-key">"source_type"</span>: <span class="json-str">"pdf"</span>,</div>
        <div class="json-row"><span class="json-key">"locator"</span>: <span class="json-str">"page 3, sec: Statutory Registration"</span>,</div>
        <div class="json-row"><span class="json-key">"start_offset"</span>: <span class="json-num">1420</span>,</div>
        <div class="json-row"><span class="json-key">"end_offset"</span>: <span class="json-num">1780</span>,</div>
        <div class="json-row"><span class="json-key">"sha256"</span>: <span class="json-str">"4b2f8a19c3e218e87d0921473fa0081d6..."</span>,</div>
        <div class="json-row"><span class="json-key">"verbatim_quote"</span>: <span class="json-str">"Incorporated in Maharashtra with registered corporate office located in Nashik, PIN 422003."</span>,</div>
        <div class="json-row"><span class="json-key">"exact_quote_match"</span>: <span class="json-bool">true</span>,</div>
        <div class="json-row"><span class="json-key">"term_coverage"</span>: <span class="json-num">0.94</span>,</div>
        <div class="json-row"><span class="json-key">"epistemic_status"</span>: <span class="json-str text-emerald">"SUPPORTED"</span></div>
        <span class="json-brace">&#125;</span>
      </div>
    </div>

    <!-- Panel 3: Validated Synthesis -->
    <div class="sim-panel" id="tab-synthesis" role="tabpanel" aria-labelledby="tab-btn-synthesis" hidden>
      <div class="report-preview">
        <div class="report-header font-display text-sm text-primary font-bold">
          AGLETRAS RESEARCH SYNTHESIS // RUN #1 (VALIDATED DELIVERABLE)
        </div>
        <div class="report-meta text-muted">
          Method: Deterministic Text Comparison • Template: Phase 6 (10 Sections) • Integrity: Verified
        </div>
        <div class="report-section">
          <div class="sec-title text-emerald font-bold">1. EXECUTIVE SUMMARY & KEY FINDINGS</div>
          <p class="text-secondary leading-relaxed">
            [F1] The entity maintains active statutory registration in Nashik, Maharashtra (PIN 422003) as confirmed by official filings <span class="text-emerald">[S1:p3]</span>. <span class="badge-status status-supported">SUPPORTED</span>
          </p>
          <p class="text-secondary leading-relaxed">
            [F2] Capitalization disclosures exhibit irreconcilable dates: filing A records $12M Series A closing August 2024 <span class="text-cyan">[S2:p1]</span>, whereas registry B records $8.5M aggregate funding <span class="text-cyan">[S3:p4]</span>. <span class="badge-status status-conflict">CONFLICTING EVIDENCE — UNRESOLVED</span>
          </p>
          <p class="text-secondary leading-relaxed">
            [F3] Claims of dominant regional market share lack corresponding primary documentation. <span class="badge-status status-unverified">UNVERIFIED</span>
          </p>
        </div>
        <div class="report-section">
          <div class="sec-title text-emerald font-bold">2. VERIFIED REFERENCES [Sn]</div>
          <div class="text-muted">[S1] Ministry Filing Archive, retrieved 2026-08-01 (SHA-256: 4b2f8a...) • Locator: page 3</div>
          <div class="text-muted">[S2] Gazette Publication Notice, retrieved 2026-08-01 (SHA-256: 9e102c...) • Locator: page 1</div>
          <div class="text-muted">[S3] Commercial Registry Extract, retrieved 2026-08-01 (SHA-256: d841ba...) • Locator: page 4</div>
        </div>
      </div>
    </div>

    <!-- Panel 4: JSON-RPC Protocol Contract -->
    <div class="sim-panel" id="tab-protocol" role="tabpanel" aria-labelledby="tab-btn-protocol" hidden>
      <div class="contract-container">
        <div class="json-comment">// Actual Stdio JSON-RPC 2.0 exchange demonstrating tools/call for 'verify_claims'</div>
        
        <div class="contract-block">
          <div class="contract-header font-mono text-xs">
            <span class="text-cyan font-bold">&gt; AGENT RUNTIME REQUEST (STDIN):</span>
            <span class="text-muted">METHOD: tools/call</span>
          </div>
          <pre class="contract-pre font-mono text-xs"><code>&#123;
  <span class="json-key">"jsonrpc"</span>: <span class="json-str">"2.0"</span>,
  <span class="json-key">"id"</span>: <span class="json-num">104</span>,
  <span class="json-key">"method"</span>: <span class="json-str">"tools/call"</span>,
  <span class="json-key">"params"</span>: &#123;
    <span class="json-key">"name"</span>: <span class="json-str">"verify_claims"</span>,
    <span class="json-key">"arguments"</span>: &#123;
      <span class="json-key">"run_id"</span>: <span class="json-num">1</span>,
      <span class="json-key">"claim_ids"</span>: [<span class="json-num">42</span>],
      <span class="json-key">"method"</span>: <span class="json-str">"deterministic"</span>
    &#125;
  &#125;
&#125;</code></pre>
        </div>

        <div class="contract-block">
          <div class="contract-header font-mono text-xs">
            <span class="text-emerald font-bold">&lt; AGLETRAS MCP SERVER RESPONSE (STDOUT):</span>
            <span class="text-muted">STATUS: 200 OK (STDIO FRAME)</span>
          </div>
          <pre class="contract-pre font-mono text-xs"><code>&#123;
  <span class="json-key">"jsonrpc"</span>: <span class="json-str">"2.0"</span>,
  <span class="json-key">"id"</span>: <span class="json-num">104</span>,
  <span class="json-key">"result"</span>: &#123;
    <span class="json-key">"run_id"</span>: <span class="json-num">1</span>,
    <span class="json-key">"verifications_evaluated"</span>: <span class="json-num">1</span>,
    <span class="json-key">"claims"</span>: [
      &#123;
        <span class="json-key">"claim_id"</span>: <span class="json-num">42</span>,
        <span class="json-key">"claim_text"</span>: <span class="json-str">"Registered corporate office located in Nashik, Maharashtra, PIN 422003"</span>,
        <span class="json-key">"epistemic_status"</span>: <span class="json-str text-emerald">"SUPPORTED"</span>,
        <span class="json-key">"matched_passage_id"</span>: <span class="json-num">12</span>,
        <span class="json-key">"term_coverage"</span>: <span class="json-num">0.94</span>,
        <span class="json-key">"exact_quote_match"</span>: <span class="json-bool">true</span>,
        <span class="json-key">"source_locator"</span>: <span class="json-str">"page 3, sec: Statutory Registration"</span>,
        <span class="json-key">"sha256"</span>: <span class="json-str">"4b2f8a19c3e218e87d0921473fa0081d6..."</span>
      &#125;
    ],
    <span class="json-key">"unresolved_conflicts_surfaced"</span>: <span class="json-num">0</span>
  &#125;
&#125;</code></pre>
        </div>
      </div>
    </div>
  </div>

  <!-- Terminal Footer Indicator -->
  <div class="terminal-footer font-mono text-xs text-muted">
    <div class="footer-left">
      <span class="beacon-dot"></span>
      <span>SIMULATED PIPELINE TELEMETRY: Demonstrates 40 registered MCP tools • Connect locally via stdio JSON-RPC for live execution</span>
    </div>
    <div class="footer-right">
      <span>Zero Mandatory Paid APIs for Core Operation</span>
    </div>
  </div>
</div>

<script>
  // Client-side tab switcher for terminal simulator with WAI-ARIA keyboard navigation
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.sim-tab-btn'))
  const tabPanels = document.querySelectorAll<HTMLElement>('.sim-panel')

  function activateTab(btn: HTMLButtonElement) {
    const targetId = btn.getAttribute('data-target')
    if (!targetId) return

    tabButtons.forEach(b => {
      b.classList.remove('is-active')
      b.setAttribute('aria-selected', 'false')
      b.tabIndex = -1
    })
    tabPanels.forEach(p => {
      p.classList.remove('is-active')
      p.hidden = true
    })

    btn.classList.add('is-active')
    btn.setAttribute('aria-selected', 'true')
    btn.tabIndex = 0
    btn.focus()
    const targetPanel = document.getElementById(targetId)
    if (targetPanel) {
      targetPanel.classList.add('is-active')
      targetPanel.hidden = false
    }
  }

  tabButtons.forEach((btn, index) => {
    btn.addEventListener('click', () => activateTab(btn))
    btn.addEventListener('keydown', (e) => {
      let targetIndex: number | null = null
      if (e.key === 'ArrowRight') {
        targetIndex = (index + 1) % tabButtons.length
      } else if (e.key === 'ArrowLeft') {
        targetIndex = (index - 1 + tabButtons.length) % tabButtons.length
      } else if (e.key === 'Home') {
        targetIndex = 0
      } else if (e.key === 'End') {
        targetIndex = tabButtons.length - 1
      }
      if (targetIndex !== null) {
        const nextBtn = tabButtons[targetIndex]
        if (nextBtn) {
          e.preventDefault()
          activateTab(nextBtn)
        }
      }
    })
  })

  // Sequential pipeline stage animation (Simulation Walkthrough)
  const stepIndicators = Array.from(document.querySelectorAll<HTMLElement>('.trace-step-indicator'))
  const stageBlocks = Array.from(document.querySelectorAll<HTMLElement>('.trace-stage-block'))
  const replayBtn = document.getElementById('btn-replay-trace') as HTMLButtonElement | null

  let traceTimeouts: number[] = []

  function clearTraceTimeouts() {
    traceTimeouts.forEach(t => clearTimeout(t))
    traceTimeouts = []
  }

  function playTraceSequence() {
    clearTraceTimeouts()

    // Respect user's motion preferences
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      stepIndicators.forEach(ind => ind.classList.add('is-completed'))
      stageBlocks.forEach(blk => blk.classList.add('is-revealed'))
      return
    }

    // Reset initial states
    stepIndicators.forEach((ind, i) => {
      ind.classList.remove('is-active', 'is-completed')
      if (i === 0) ind.classList.add('is-active')
    })
    stageBlocks.forEach(blk => blk.classList.remove('is-revealed'))

    // Stage 1 appears immediately
    stageBlocks[0]?.classList.add('is-revealed')

    // Stagger stages 2-5
    const delays = [0, 480, 960, 1440, 1920]
    for (let i = 1; i < stageBlocks.length; i++) {
      const timer = window.setTimeout(() => {
        // Mark previous steps completed
        for (let j = 0; j < i; j++) {
          stepIndicators[j]?.classList.remove('is-active')
          stepIndicators[j]?.classList.add('is-completed')
        }
        // Activate current step and reveal stage block
        stepIndicators[i]?.classList.add('is-active')
        stageBlocks[i]?.classList.add('is-revealed')

        if (i === stageBlocks.length - 1) {
          // Final stage reached: mark all completed after brief pause
          const finishTimer = window.setTimeout(() => {
            stepIndicators[i]?.classList.remove('is-active')
            stepIndicators[i]?.classList.add('is-completed')
          }, 600)
          traceTimeouts.push(finishTimer)
        }
      }, delays[i])
      traceTimeouts.push(timer)
    }
  }

  // Trigger sequence when trace panel is visible via IntersectionObserver
  let hasAnimatedOnce = false
  if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
    const traceSection = document.getElementById('tab-trace')
    if (traceSection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !hasAnimatedOnce) {
            hasAnimatedOnce = true
            playTraceSequence()
          }
        })
      }, { threshold: 0.15 })
      observer.observe(traceSection)
    }
  } else {
    // Zero-JS or no IntersectionObserver: reveal everything
    stageBlocks.forEach(blk => blk.classList.add('is-revealed'))
    stepIndicators.forEach(ind => ind.classList.add('is-completed'))
  }

  if (replayBtn) {
    replayBtn.addEventListener('click', () => {
      playTraceSequence()
    })
  }
</script>

<style>
  .terminal-card {
    grid-column: 1 / -1;
    min-width: 0;
    box-sizing: border-box;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background-color: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-hairline);
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ctrl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background-color: #ff5f56; }
  .dot-yellow { background-color: #ffbd2e; }
  .dot-green { background-color: #27c93f; }

  .terminal-badge {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .simulation-banner {
    padding: 10px 18px;
    background-color: rgba(245, 158, 11, 0.08);
    border-bottom: 1px solid rgba(245, 158, 11, 0.2);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .sim-banner-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 8px;
    flex-wrap: wrap;
  }

  .sim-live-badge {
    padding: 2px 7px;
    border-radius: 3px;
    background-color: rgba(46, 186, 135, 0.12);
    border: 1px solid rgba(46, 186, 135, 0.3);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .contract-container {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contract-block {
    background-color: rgba(0, 0, 0, 0.45);
    border: 1px solid var(--border-hairline);
    border-radius: 6px;
    overflow: hidden;
  }

  .contract-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background-color: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-hairline);
  }

  .contract-pre {
    margin: 0;
    padding: 14px;
    overflow-x: auto;
    line-height: 1.6;
    background-color: transparent;
  }

  .terminal-nav {
    display: flex;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-hairline);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .terminal-nav::-webkit-scrollbar {
