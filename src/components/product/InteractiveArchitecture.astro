    font-weight: 700;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .tier-btn-sub {
    line-height: 1.4;
  }

  /* Right Detail Column */
  .arch-detail-column {
    padding: 28px 32px;
    background-color: #030705;
  }

  .arch-detail-panel {
    display: none;
  }

  .arch-detail-panel.is-active {
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: archFadeSlide 0.24s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes archFadeSlide {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .detail-header {
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 16px;
  }

  .detail-kicker {
    letter-spacing: 0.05em;
  }

  .detail-h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 4px 0 6px;
  }

  .detail-lead {
    font-size: 0.95rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .spec-card {
    padding: 16px 18px;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-hairline);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spec-header {
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.04em;
  }

  .spec-icon {
    font-size: 0.85rem;
  }

  .modules-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background-color: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border-hairline);
    border-radius: 6px;
    flex-wrap: wrap;
  }

  .modules-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .module-tag {
    padding: 2px 8px;
    background-color: rgba(46, 186, 135, 0.08);
    border: 1px solid rgba(46, 186, 135, 0.2);
    border-radius: 3px;
    color: var(--brand-green-bright);
    font-size: 0.72rem;
  }

  .payload-box {
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px solid var(--border-hairline);
    border-radius: 6px;
    overflow: hidden;
  }

  .payload-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background-color: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-hairline);
  }

  .payload-pre {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    color: #a7f3d0;
    line-height: 1.6;
    background-color: transparent;
  }

  .arch-footer {
    padding: 12px 20px;
    background-color: var(--bg-surface-elevated);
    border-top: 1px solid var(--border-hairline);
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-detail-panel.is-active {
      animation: none !important;
    }
    .arch-tier-btn {
      transition: none !important;
    }
  }

  @media (max-width: 900px) {
    .arch-container {
      grid-template-columns: 1fr;
    }
    .arch-nav-column {
      border-right: none;
      border-bottom: 1px solid var(--border-hairline);
      max-height: 280px;
      overflow-y: auto;
    }
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .arch-detail-column {
      padding: 20px 16px;
    }
  }

  @media (max-width: 640px) {
    .arch-top-bar {
      padding: 10px 14px;
    }
    .arch-tier-btn {
      padding: 12px 14px;
    }
    .arch-detail-column {
      padding: 16px 12px;
    }
    .arch-footer {
      padding: 10px 14px;
    }
  }
</style>
