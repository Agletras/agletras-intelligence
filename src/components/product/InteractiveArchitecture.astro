    font-size: 0.68rem;
  }

  .arch-tier-btn.is-active .tier-badge {
    background-color: rgba(46, 186, 135, 0.12);
    border-color: rgba(46, 186, 135, 0.3);
    color: var(--brand-green-bright);
  }

  .tier-btn-title {
