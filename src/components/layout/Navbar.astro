---
import { paths, withBase } from '@/lib/routes'

interface Props {
  currentPath?: string
}

const { currentPath = '/' } = Astro.props

const navLinks: Array<{ label: string; href: string; external?: boolean }> = [
  { label: 'Home', href: paths.home() },
  { label: 'Agletras Intelligence', href: paths.intelligence() },
  { label: 'Human-Led Research', href: withBase('/#human-led') },
  { label: 'Capabilities', href: withBase('/#capabilities') },
  { label: 'Methodology', href: paths.methodology() },
  { label: 'About', href: paths.about() },
  { label: 'Contact', href: paths.contact() },
]
---

<header class="site-header" id="site-header">
  <div class="grid-container header-inner">
    {/* Left: Brand Identity with verified authentic logo */}
    <div class="brand-col">
      <a href={paths.home()} class="brand-link" aria-label="Agletras Home">
        <img 
          src={withBase('/logo.png')} 
          alt="Agletras Logo" 
          width="36" 
          height="36" 
          class="brand-logo" 
          loading="eager" 
          decoding="async"
        />
        <div class="brand-titles">
          <span class="brand-name">AGLETRAS</span>
          <span class="brand-tag">INTELLIGENCE</span>
        </div>
      </a>
    </div>

    {/* Right: Desktop Navigation & Action */}
    <nav class="nav-col" aria-label="Primary Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
          return (
            <li>
              <a 
                href={link.href} 
                class={`nav-link ${isActive ? 'is-active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          )
        })}
      </ul>

      <a href={paths.contact()} class="btn-primary header-cta">
        <span>Get in Touch</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      {/* Redesigned Premium Mobile Navigation Control */}
      <button 
        type="button" 
        class="mobile-toggle" 
        id="mobile-nav-toggle" 
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <span class="toggle-icon-wrap" aria-hidden="true">
          <span class="toggle-bar bar-top"></span>
          <span class="toggle-bar bar-bottom"></span>
        </span>
      </button>
    </nav>
  </div>

  {/* Mobile Navigation Drawer */}
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <div class="mobile-telemetry font-mono text-xs">
        <span class="beacon-dot"></span>
        <span>EVIDENCE-FIRST RESEARCH INTELLIGENCE</span>
      </div>

      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class="mobile-nav-link font-display"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-cta-wrap">
        <a href={paths.contact()} class="btn-primary" style="width: 100%; text-align: center;">
          Contact Intelligence Team
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 500;
    background: rgba(3, 7, 5, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-hairline);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .site-header.is-menu-open {
    background: var(--bg-deep) !important;
    background-color: var(--bg-deep) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .header-inner {
    height: 72px;
    align-items: center;
  }

  .brand-col {
    grid-column: span 8;
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-logo {
    display: block;
    object-fit: contain;
    border-radius: 4px;
    filter: drop-shadow(0 0 10px rgba(16, 185, 129, 0.3));
  }

  .brand-titles {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    line-height: 1;
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--brand-green-bright);
    margin-top: 3px;
  }

  .nav-col {
    grid-column: span 24;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: 6px 0;
    position: relative;
    white-space: nowrap;
  }

  .nav-link:hover, .nav-link.is-active {
    color: var(--text-primary);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--brand-green-bright);
    box-shadow: 0 0 8px var(--brand-green-bright);
  }

  .header-cta {
    padding: 0.65rem 1.25rem;
    font-size: 0.75rem;
  }

  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: rgba(6, 18, 12, 0.7);
    border: 1px solid rgba(16, 185, 129, 0.28);
    border-radius: 8px;
    cursor: pointer;
    position: relative;
    transition: all var(--transition-fast);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 1px 0 rgba(16, 185, 129, 0.15), 0 2px 6px rgba(0, 0, 0, 0.4);
  }

  .mobile-toggle:hover {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.7);
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.28), inset 0 1px 0 rgba(16, 185, 129, 0.25);
  }

  .mobile-toggle:focus-visible {
    outline: 2px solid var(--brand-green-bright);
    outline-offset: 3px;
  }

  .mobile-toggle:active {
    transform: scale(0.94);
  }

  .mobile-toggle[aria-expanded="true"] {
    background: rgba(16, 185, 129, 0.18);
    border-color: var(--brand-green-bright);
    box-shadow: 0 0 18px rgba(16, 185, 129, 0.35);
  }

  .toggle-icon-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 20px;
    height: 14px;
    position: relative;
    pointer-events: none;
  }

  .toggle-bar {
    display: block;
    height: 2px;
    border-radius: 2px;
    background-color: var(--text-primary);
    position: absolute;
    transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, width 0.25s ease, top 0.26s ease, bottom 0.26s ease;
  }

  .bar-top {
    top: 2px;
    width: 18px;
    background-color: var(--text-primary);
  }

  .bar-bottom {
    bottom: 2px;
    width: 12px;
    right: 1px;
    background-color: var(--brand-green-bright);
  }

  .mobile-toggle:hover .bar-bottom {
    width: 18px;
  }

  .mobile-toggle[aria-expanded="true"] .bar-top {
    top: 6px;
    width: 18px;
    transform: rotate(45deg);
    background-color: var(--brand-green-bright);
  }

  .mobile-toggle[aria-expanded="true"] .bar-bottom {
    bottom: 6px;
    width: 18px;
    transform: rotate(-45deg);
    background-color: var(--brand-green-bright);
  }

  .mobile-drawer {
    display: none;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100vh - 72px);
    height: calc(100dvh - 72px);
    background: var(--bg-deep) !important;
    background-color: var(--bg-deep) !important;
    border-top: 1px solid var(--border-subtle);
    padding: 24px var(--grid-margin);
    z-index: 999;
    transform: translateY(-100%);
    opacity: 0;
    transition: transform var(--transition-base), opacity var(--transition-base);
    pointer-events: none;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    background: var(--bg-deep) !important;
    background-color: var(--bg-deep) !important;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 32px 0;
  }

  .mobile-nav-link {
    font-size: clamp(1.4rem, 5vw, 1.8rem);
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .mobile-nav-link:hover {
    color: var(--brand-green-bright);
  }

  @media (max-width: 1140px) {
    .site-header {
      background: var(--bg-deep) !important;
      background-color: var(--bg-deep) !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
    .brand-col {
      grid-column: span 24;
    }
    .nav-col {
      grid-column: span 8;
    }
    .nav-list, .header-cta {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
    .mobile-drawer {
      display: block;
    }
  }

  @media (max-width: 768px) {
    .brand-col {
      grid-column: span 6;
    }
    .nav-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 480px) {
    .brand-col {
      grid-column: span 3;
    }
    .nav-col {
      grid-column: span 1;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-nav-toggle') as HTMLButtonElement | null
  const drawer = document.getElementById('mobile-nav-drawer') as HTMLElement | null
  const header = document.getElementById('site-header') as HTMLElement | null

  if (toggle && drawer) {
    const closeDrawer = () => {
      drawer.classList.remove('is-open')
      if (header) header.classList.remove('is-menu-open')
      toggle.setAttribute('aria-expanded', 'false')
      toggle.setAttribute('aria-label', 'Open navigation menu')
      drawer.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    toggle.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('is-open')
      if (header) {
        header.classList.toggle('is-menu-open', isOpen)
      }
      toggle.setAttribute('aria-expanded', String(isOpen))
      toggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu')
      drawer.setAttribute('aria-hidden', String(!isOpen))
      document.body.style.overflow = isOpen ? 'hidden' : ''
    })

    // Close on mobile link click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeDrawer)
    })

    // Close on Escape key press
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer()
        toggle.focus()
      }
    })
  }
</script>
