---
import { paths, withBase } from '@/lib/routes'
import { companyData } from '@/lib/companyData'
---

<footer class="site-footer" id="site-footer">
  <div class="grid-container footer-main">
    {/* Column 1: Identity & Brand */}
    <div class="footer-col-brand">
      <div class="footer-brand-header">
        <img
          src={withBase('/logo.png')}
          alt="Agletras"
          width="36"
          height="36"
          class="footer-logo"
          loading="lazy"
          decoding="async"
        />
        <div class="brand-naming">
          <span class="footer-brand-title font-display">AGLETRAS</span>
          <span class="footer-brand-sub font-mono text-xs text-emerald">RESEARCH & INTELLIGENCE</span>
        </div>
      </div>

      <p class="footer-tagline text-body-sm text-secondary">
        Evidence-backed corporate intelligence and research infrastructure. We turn fragmented public records into well-supported findings.
      </p>

      <div class="footer-socials">
        <a
          href={companyData.contacts.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          class="social-brand-link"
          aria-label="Agletras on GitHub"
          title="Agletras on GitHub"
        >
          <svg class="brand-icon icon-github" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <a
          href={companyData.contacts.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="social-brand-link"
          aria-label="Agletras on LinkedIn"
          title="Agletras on LinkedIn"
        >
          <svg class="brand-icon icon-linkedin" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8m-1.39 9.74h2.79v-8.37H5.07v8.37Z" />
          </svg>
        </a>

        <a
          href={companyData.contacts.socials.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="social-brand-link"
          aria-label="Agletras on Instagram"
          title="Agletras on Instagram"
        >
          <svg class="brand-icon icon-instagram" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.07-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z" />
          </svg>
        </a>
      </div>
    </div>

    {/* Column 2: Agletras Intelligence */}
    <div class="footer-col-nav">
      <h4 class="footer-heading font-mono text-xs text-muted">AGLETRAS INTELLIGENCE</h4>
      <ul class="footer-links">
        <li>
          <a href={paths.intelligence()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>What We Do</span>
          </a>
        </li>
        <li>
          <a href={`${paths.intelligence()}#capabilities`} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Our Capabilities</span>
          </a>
        </li>
        <li>
          <a href={`${paths.intelligence()}#services`} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Research Services</span>
          </a>
        </li>
        <li>
          <a href={paths.contact()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Start an Engagement</span>
          </a>
        </li>
      </ul>
    </div>

    {/* Column 3: Corporate & Legal */}
    <div class="footer-col-nav">
      <h4 class="footer-heading font-mono text-xs text-muted">CORPORATE</h4>
      <ul class="footer-links">
        <li>
          <a href={paths.about()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>About Agletras</span>
          </a>
        </li>
        <li>
          <a href={paths.contact()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Contact & Inquiries</span>
          </a>
        </li>
        <li>
          <a href={paths.terms()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Terms of Engagement</span>
          </a>
        </li>
        <li>
          <a href={paths.privacy()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Privacy Policy</span>
          </a>
        </li>
      </ul>
    </div>

    {/* Column 4: Contact & Open Source */}
    <div class="footer-col-nav">
      <h4 class="footer-heading font-mono text-xs text-muted">OPEN SOURCE & INTAKE</h4>
      <ul class="footer-links">
        <li>
          <a href="https://github.com/Agletras/Agletras-mcp.git" target="_blank" rel="noopener noreferrer" class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Open Source Repository</span>
            <span class="arrow-glyph">↗</span>
          </a>
        </li>
      </ul>

      <div class="footer-contact-block">
        <span class="text-muted font-mono text-xs font-semibold">DIRECT INQUIRIES:</span>
        <a href={`mailto:${companyData.contacts.corporateEmail}`} class="footer-email font-mono text-xs text-emerald">
          {companyData.contacts.corporateEmail}
        </a>
      </div>
    </div>
  </div>

  {/* Compact Operational Boundary Link Bar */}
  <div class="grid-container footer-ethics">
    <div class="ethics-bar font-mono text-xs">
      <span class="beacon-dot"></span>
      <a href={`${paths.about()}#guarantee`} class="ethics-link">
        <span class="ethics-title text-emerald font-bold">OPERATIONAL BOUNDARY & NON-INTRUSION CHARTER</span>
        <span class="ethics-desc text-secondary"> — Strict open-source intelligence standards: zero unauthorized network intrusion &rarr;</span>
      </a>
    </div>
  </div>

  {/* Bottom Bar */}
  <div class="grid-container footer-bottom font-mono text-xs text-muted">
    <div class="bottom-left">
      © {new Date().getFullYear()} AGLETRAS. All rights reserved.
    </div>
    <div class="bottom-right">
      <span class="jurisdiction-tag">JURISDICTION: NASHIK, MH, INDIA</span>
      <span class="separator">|</span>
      <span class="classification-tag text-emerald">CLASSIFIED PUBLIC OSINT RESEARCH</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-hairline);
    padding-top: 56px;
    padding-bottom: 40px;
    position: relative;
    z-index: 10;
  }

  .footer-main {
    row-gap: 40px;
    margin-bottom: 36px;
  }

  .footer-col-brand {
    grid-column: span 11;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-logo {
    display: block;
    object-fit: contain;
    border-radius: 4px;
    filter: grayscale(100%) contrast(210%) brightness(125%) drop-shadow(0 0 6px rgba(255, 255, 255, 0.2));
    mix-blend-mode: screen;
  }

  .brand-naming {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-brand-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    line-height: 1;
  }

  .footer-brand-sub {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .footer-tagline {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 4px;
  }

  .social-brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 6px;
    padding: 2px;
    transition: transform var(--transition-fast), filter var(--transition-fast), opacity var(--transition-fast);
    outline: none;
  }

  .social-brand-link:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0 0 8px rgba(16, 185, 129, 0.65));
  }

  .social-brand-link:focus-visible {
    outline: 2px solid var(--brand-green-bright);
    outline-offset: 3px;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
  }

  .brand-icon {
    display: block;
    width: 28px;
    height: 28px;
    transition: opacity var(--transition-fast);
  }

  .icon-github,
  .icon-linkedin,
  .icon-instagram {
    color: #F0F6FC;
    fill: currentColor;
    opacity: 0.9;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .social-brand-link:hover .icon-github,
  .social-brand-link:hover .icon-linkedin,
  .social-brand-link:hover .icon-instagram {
    opacity: 1;
    color: #FFFFFF;
  }

  .social-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .social-link:hover {
    color: var(--brand-green-bright);
  }

  .arrow-glyph {
    font-size: 0.75rem;
    transition: transform var(--transition-fast);
  }

  .footer-link:hover .arrow-glyph {
    transform: translate(2px, -2px);
  }

  .footer-col-nav {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-heading {
    letter-spacing: 0.14em;
    font-weight: 700;
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 10px;
    color: var(--text-muted);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.45;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .link-bullet {
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--text-primary);
    transform: translateX(3px);
  }

  .footer-link:hover .link-bullet {
    opacity: 1;
    color: var(--brand-green-bright);
  }

  .text-emerald {
    color: var(--brand-green-bright);
  }

  .footer-contact-block {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-email {
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast);
  }

  .footer-email:hover {
    color: var(--brand-green-electric);
    text-decoration: underline;
  }

  .footer-ethics {
    margin-bottom: 40px;
  }

  .footer-ethics {
    margin-bottom: 28px;
  }

  .ethics-bar {
    grid-column: span 32;
    padding: 12px 18px;
    background: rgba(16, 185, 129, 0.03);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ethics-link {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .ethics-link:hover {
    opacity: 0.85;
  }

  .ethics-title {
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }

  .ethics-desc {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.75rem;
  }

  .separator {
    margin: 0 10px;
    opacity: 0.3;
  }

  .jurisdiction-tag {
    color: var(--text-muted);
  }

  .classification-tag {
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .footer-col-brand {
      grid-column: span 16;
    }
    .footer-col-nav {
      grid-column: span 8;
    }
    .ethics-bar {
      grid-column: span 32;
    }
  }

  @media (max-width: 768px) {
    .footer-col-brand {
      grid-column: span 8;
    }
    .footer-col-nav {
      grid-column: span 8;
    }
    .ethics-panel {
      grid-column: span 8;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .footer-col-brand,
    .footer-col-nav,
    .ethics-panel {
      grid-column: span 4;
    }
  }
</style>
