---
import { paths, withBase } from '@/lib/routes'
import { companyData } from '@/lib/companyData'
---

<footer class="site-footer" id="site-footer">
  <div class="grid-container footer-main">
    {/* Column 1: Identity & Brand */}
    <div class="footer-col-brand">
      <div class="footer-brand-header">
        <img 
          src={withBase('/logo.png')} 
          alt="Agletras" 
          width="36" 
          height="36" 
          class="footer-logo" 
          loading="lazy" 
          decoding="async"
        />
        <div class="brand-naming">
          <span class="footer-brand-title font-display">AGLETRAS</span>
          <span class="footer-brand-sub font-mono text-xs text-emerald">RESEARCH & INTELLIGENCE</span>
        </div>
      </div>

      <p class="footer-tagline text-body-sm text-secondary">
        Evidence-backed corporate intelligence and research infrastructure. We turn fragmented public records into well-supported findings.
      </p>

      <div class="footer-socials">
        <a 
          href={companyData.contacts.socials.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-brand-link" 
          aria-label="Agletras on GitHub"
        >
          <svg class="brand-icon icon-github" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <a 
          href={companyData.contacts.socials.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-brand-link" 
          aria-label="Agletras on LinkedIn"
        >
          <svg class="brand-icon icon-linkedin" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <rect width="24" height="24" rx="4" fill="#0A66C2" />
            <path fill="#FFFFFF" fill-rule="evenodd" clip-rule="evenodd" d="M7.4 9.17H4.8V19H7.4V9.17ZM6.1 4.5C5.27 4.5 4.6 5.17 4.6 6C4.6 6.83 5.27 7.5 6.1 7.5C6.93 7.5 7.6 6.83 7.6 6C7.6 5.17 6.93 4.5 6.1 4.5ZM19.2 13.75C19.2 11.23 17.85 10.05 16.05 10.05C14.6 10.05 13.95 10.85 13.58 11.42V10.23H11.02C11.05 10.95 11.02 19 11.02 19H13.58V14.1C13.58 13.84 13.6 13.57 13.68 13.38C13.89 12.85 14.37 12.3 15.18 12.3C16.24 12.3 16.66 13.11 16.66 14.3V19H19.2V13.75Z" />
          </svg>
        </a>
      </div>
    </div>

    {/* Column 2: Agletras Intelligence */}
    <div class="footer-col-nav">
      <h4 class="footer-heading font-mono text-xs text-muted">AGLETRAS INTELLIGENCE</h4>
      <ul class="footer-links">
        <li>
          <a href={paths.intelligence()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>What We Do</span>
          </a>
        </li>
        <li>
          <a href={`${paths.intelligence()}#capabilities`} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Our Capabilities</span>
          </a>
        </li>
        <li>
          <a href={`${paths.intelligence()}#services`} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Research Services</span>
          </a>
        </li>
        <li>
          <a href={paths.contact()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Start an Engagement</span>
          </a>
        </li>
      </ul>
    </div>

    {/* Column 3: Corporate & Legal */}
    <div class="footer-col-nav">
      <h4 class="footer-heading font-mono text-xs text-muted">CORPORATE</h4>
      <ul class="footer-links">
        <li>
          <a href={paths.about()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>About Agletras</span>
          </a>
        </li>
        <li>
          <a href={paths.contact()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Contact & Inquiries</span>
          </a>
        </li>
        <li>
          <a href={paths.terms()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Terms of Engagement</span>
          </a>
        </li>
        <li>
          <a href={paths.privacy()} class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Privacy Policy</span>
          </a>
        </li>
      </ul>
    </div>

    {/* Column 4: Contact & Open Source */}
    <div class="footer-col-nav">
      <h4 class="footer-heading font-mono text-xs text-muted">OPEN SOURCE & INTAKE</h4>
      <ul class="footer-links">
        <li>
          <a href="https://github.com/Agletras/Agletras-mcp.git" target="_blank" rel="noopener noreferrer" class="footer-link">
            <span class="link-bullet text-emerald">›</span>
            <span>Open Source Repository</span>
            <span class="arrow-glyph">↗</span>
          </a>
        </li>
      </ul>

      <div class="footer-contact-block">
        <span class="text-muted font-mono text-xs font-semibold">DIRECT INQUIRIES:</span>
        <a href={`mailto:${companyData.contacts.corporateEmail}`} class="footer-email font-mono text-xs text-emerald">
          {companyData.contacts.corporateEmail}
        </a>
      </div>
    </div>
  </div>

  {/* Compact Operational Boundary Link Bar */}
  <div class="grid-container footer-ethics">
    <div class="ethics-bar font-mono text-xs">
      <span class="beacon-dot"></span>
      <a href={`${paths.about()}#guarantee`} class="ethics-link">
        <span class="ethics-title text-emerald font-bold">OPERATIONAL BOUNDARY & NON-INTRUSION CHARTER</span>
        <span class="ethics-desc text-secondary"> — Strict open-source intelligence standards: zero unauthorized network intrusion &rarr;</span>
      </a>
    </div>
  </div>

  {/* Bottom Bar */}
  <div class="grid-container footer-bottom font-mono text-xs text-muted">
    <div class="bottom-left">
      © {new Date().getFullYear()} AGLETRAS. All rights reserved.
    </div>
    <div class="bottom-right">
      <span class="jurisdiction-tag">JURISDICTION: NASHIK, MH, INDIA</span>
      <span class="separator">|</span>
      <span class="classification-tag text-emerald">CLASSIFIED PUBLIC OSINT RESEARCH</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-hairline);
    padding-top: 56px;
    padding-bottom: 40px;
    position: relative;
    z-index: 10;
  }

  .footer-main {
    row-gap: 40px;
    margin-bottom: 36px;
  }

  .footer-col-brand {
    grid-column: span 11;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .footer-brand-header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-naming {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-brand-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    line-height: 1;
  }

  .footer-brand-sub {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .footer-tagline {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 4px;
  }

  .social-brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 6px;
    padding: 2px;
    transition: transform var(--transition-fast), filter var(--transition-fast), opacity var(--transition-fast);
    outline: none;
  }

  .social-brand-link:hover {
    transform: translateY(-2px);
    filter: drop-shadow(0 0 8px rgba(16, 185, 129, 0.65));
  }

  .social-brand-link:focus-visible {
    outline: 2px solid var(--brand-green-bright);
    outline-offset: 3px;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
  }

  .brand-icon {
    display: block;
    width: 28px;
    height: 28px;
    transition: opacity var(--transition-fast);
  }

  .icon-github {
    color: #F0F6FC;
    fill: currentColor;
    opacity: 0.9;
  }

  .social-brand-link:hover .icon-github {
    opacity: 1;
    color: #FFFFFF;
  }

  .icon-linkedin {
    opacity: 0.92;
  }

  .social-brand-link:hover .icon-linkedin {
    opacity: 1;
  }

  .social-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .social-link:hover {
    color: var(--brand-green-bright);
  }

  .arrow-glyph {
    font-size: 0.75rem;
    transition: transform var(--transition-fast);
  }

  .footer-link:hover .arrow-glyph {
    transform: translate(2px, -2px);
  }

  .footer-col-nav {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-heading {
    letter-spacing: 0.14em;
    font-weight: 700;
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 10px;
    color: var(--text-muted);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.45;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .link-bullet {
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--text-primary);
    transform: translateX(3px);
  }

  .footer-link:hover .link-bullet {
    opacity: 1;
    color: var(--brand-green-bright);
  }

  .text-emerald {
    color: var(--brand-green-bright);
  }

  .footer-contact-block {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-email {
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast);
  }

  .footer-email:hover {
    color: var(--brand-green-electric);
    text-decoration: underline;
  }

  .footer-ethics {
    margin-bottom: 40px;
  }

  .footer-ethics {
    margin-bottom: 28px;
  }

  .ethics-bar {
    grid-column: span 32;
    padding: 12px 18px;
    background: rgba(16, 185, 129, 0.03);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ethics-link {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .ethics-link:hover {
    opacity: 0.85;
  }

  .ethics-title {
    letter-spacing: 0.08em;
    font-size: 0.72rem;
  }

  .ethics-desc {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.75rem;
  }

  .separator {
    margin: 0 10px;
    opacity: 0.3;
  }

  .jurisdiction-tag {
    color: var(--text-muted);
  }

  .classification-tag {
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .footer-col-brand {
      grid-column: span 16;
    }
    .footer-col-nav {
      grid-column: span 8;
    }
    .ethics-bar {
      grid-column: span 32;
    }
  }

  @media (max-width: 768px) {
    .footer-col-brand {
      grid-column: span 8;
    }
    .footer-col-nav {
      grid-column: span 8;
    }
    .ethics-panel {
      grid-column: span 8;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .footer-col-brand,
    .footer-col-nav,
    .ethics-panel {
      grid-column: span 4;
    }
  }
</style>
