---
import BaseLayout from '@/components/layout/BaseLayout.astro'
import { paths } from '@/lib/routes'

const customerCapabilities = [
  {
    number: '01',
    title: 'Research Information',
    description: 'Automate information collection across corporate registers, regulatory filings, official gazettes, and public archives. Research information across complex multi-source environments without manual searching.',
  },
  {
    number: '02',
    title: 'Verify Evidence',
    description: 'Preserve exact text passages with cryptographic digital fingerprints. Collect and check evidence directly against original source documents to identify supported facts, conflicting records, and contradictions.',
  },
  {
    number: '03',
    title: 'Generate Intelligence',
    description: 'Cross-reference corporate claims, financial filings, and compliance histories. Connect information to produce useful insights and board-ready, structured research deliverables.',
  },
]

const workflowStages = [
  {
    stage: '01',
    title: 'Ingestion',
    description: 'Safely parse PDF, DOCX, XLSX, CSV, Markdown, and web text with SSRF network protections.',
  },
  {
    stage: '02',
    title: 'Preservation',
    description: 'Extract discrete passages with deterministic SHA-256 fingerprints to detect changes.',
  },
  {
    stage: '03',
    title: 'Indexing',
    description: 'Index preserved passages in local SQLite FTS5 for fast, run-scoped full-text search.',
  },
  {
    stage: '04',
    title: 'Verification',
    description: 'Check factual propositions against source passages for quotes, numbers, and dates.',
  },
  {
    stage: '05',
    title: 'Reporting',
    description: 'Generate structured dossiers and branded Word (.docx) deliverables with citation registers.',
  },
]

const demoFindings = [
  {
    claim: 'Dr. Elena Rostova has served as Chief Technology Officer since January 2020.',
    status: 'SUPPORTED',
    badgeClass: 'badge-supported',
    finding: 'Corroborated verbatim across corporate profiles, director filings, and public industry gazettes.',
  },
  {
    claim: 'Kestrel Cybernetics Ltd was incorporated on March 14, 2019 under registration number SYNT-884219-UK.',
    status: 'CONFLICTING EVIDENCE',
    badgeClass: 'badge-conflict',
    finding: 'Incorporation filings support 2019 registration; an unresolved calendar-year conflict was flagged against a 2025 gazette confirmation filing.',
  },
  {
    claim: 'Kestrel Cybernetics Ltd maintains an active ISO 27001 cybersecurity certification.',
    status: 'CONFLICTING EVIDENCE',
    badgeClass: 'badge-conflict',
    finding: 'Vendor pitch claimed active certification, but independent forensic audit records revealed accreditation was formally revoked in November 2023.',
  },
  {
    claim: 'Kestrel Cybernetics employs 500 security-cleared engineers across its London facility.',
    status: 'CONFLICTING EVIDENCE',
    badgeClass: 'badge-conflict',
    finding: 'Commercial sales deck asserted 500 engineers; an on-site physical headcount audit verified exactly 42 permanent employees.',
  },
  {
    claim: 'Annual operating turnover for fiscal year 2025 was £14,200,000.',
    status: 'CONFLICTING EVIDENCE',
    badgeClass: 'badge-conflict',
    finding: 'Commercial presentation asserted £14.2M turnover; audited statutory accounts recorded £3,150,000.',
  },
  {
    claim: 'Holds a granted patent for proprietary quantum-resistant cryptographic hardware.',
    status: 'CONTRADICTED',
    badgeClass: 'badge-contradicted',
    finding: 'Official patent registry examination confirmed zero registered or pending hardware patents.',
  },
]

const humanServices = [
  {
    title: 'Business Partner & Company Checks',
    description: 'Independent public-record checks on prospective partners, suppliers, and acquisition targets before signing agreements.',
  },
  {
    title: 'Company Ownership & Relationships',
    description: 'Research across corporate registers to trace ownership structures, parent companies, and business connections.',
  },
  {
    title: 'Leadership Background & Online Exposure',
    description: 'Clear verification of executive career histories, confirmed directorships, and public digital security exposure.',
  },
  {
    title: 'Online Threats & Brand Impersonation',
    description: 'Monitoring the web for lookalike domains, deceptive websites, and unauthorized brand use.',
  },
]
---

<BaseLayout
  title="Agletras Intelligence — Verifiable Research Technology"
  description="Agletras Intelligence is research technology that helps analysts and AI agents collect information, examine evidence, verify claims and generate structured research reports."
  currentPath="/intelligence"
>
  <div class="intelligence-page">
    {/* 1. Introduction / What We Do */}
    <section class="intel-hero">
      <div class="grid-container">
        <div class="hero-content">
          <div class="eyebrow-badge">
            <span class="beacon-dot"></span>
            <span class="font-mono text-xs text-emerald font-bold">
              WHAT WE DO
            </span>
          </div>

          <h1 class="hero-headline font-display">
            Agletras Intelligence
          </h1>

          <p class="hero-intro text-secondary leading-relaxed">
            Agletras Intelligence combines automated research technology with human analytical expertise to gather, check, and make sense of complex public information. We turn fragmented records into clear, well-supported findings.
          </p>

          <p class="hero-subtext text-muted text-sm leading-relaxed">
            Built for corporate analysts and AI agents, our platform automates multi-source information collection, verifies factual claims directly against original source records, and produces citation-backed deliverables.
          </p>
        </div>
      </div>
    </section>

    {/* 2. Three Core Customer-Facing Capabilities */}
    <section class="intel-capabilities" id="capabilities">
      <div class="grid-container">
        <div class="section-lead">
          <span class="section-kicker font-mono text-xs text-emerald font-bold">CORE CAPABILITIES</span>
          <h2 class="section-title font-display">How Agletras Intelligence Works</h2>
          <p class="section-desc text-secondary text-sm leading-relaxed">
            Three streamlined capabilities designed to transform complex public records into actionable, verifiable intelligence.
          </p>
        </div>

        <div class="capabilities-grid">
          {customerCapabilities.map((cap) => (
            <div class="capability-card panel-telemetry">
              <span class="capability-num font-mono text-xs text-emerald font-bold">{cap.number}</span>
              <h3 class="capability-title font-display">{cap.title}</h3>
              <p class="capability-desc text-secondary text-sm leading-relaxed">{cap.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 3. Visual Workflow Pipeline */}
    <section class="intel-workflow">
      <div class="grid-container">
        <div class="section-lead">
          <span class="section-kicker font-mono text-xs text-emerald font-bold">SYSTEM PIPELINE</span>
          <h2 class="section-title font-display">Evidentiary Workflow</h2>
          <p class="section-desc text-secondary text-sm leading-relaxed">
            A transparent five-stage pipeline from raw source documents to verified research deliverables.
          </p>
        </div>

        <div class="workflow-steps">
          {workflowStages.map((st, idx) => (
            <>
              <div class="workflow-step panel-telemetry">
                <span class="step-num font-mono text-xs text-emerald font-bold">STAGE {st.stage}</span>
                <h4 class="step-title font-display">{st.title}</h4>
                <p class="step-desc text-secondary text-xs leading-relaxed">{st.description}</p>
              </div>
              {idx < workflowStages.length - 1 && (
                <div class="workflow-arrow" aria-hidden="true">&rarr;</div>
              )}
            </>
          ))}
        </div>
      </div>
    </section>

    {/* 4. Product Demonstration (Synthetic) */}
    <section class="intel-demo" id="demonstration">
      <div class="grid-container">
        <div class="section-lead">
          <span class="section-kicker font-mono text-xs text-emerald font-bold">SYNTHETIC DEMONSTRATION — FICTIONAL COMPANY AND RECORDS</span>
          <h2 class="section-title font-display">Counterparty & Vendor Due Diligence</h2>
          <p class="section-desc text-secondary text-sm leading-relaxed">
            Synthetic demonstration — fictional company and records. To demonstrate evidentiary verification without using private client disclosures, our pipeline audited a simulated vendor (&ldquo;Kestrel Cybernetics Ltd&rdquo;) using intentionally created synthetic filings, capability proposals, and compliance audits. Kestrel Cybernetics Ltd is not a real company, client, or completed commercial engagement.
          </p>
        </div>

        <div class="demo-panel panel-telemetry">
          <div class="demo-header">
            <div class="demo-meta font-mono text-xs">
              <span class="beacon-dot"></span>
              <span>SYNTHETIC AUDIT WORKFLOW (SIMULATED DUE DILIGENCE)</span>
            </div>
            <span class="demo-label font-mono text-xs text-emerald font-bold">SYNTHETIC RECORDS</span>
          </div>

          <div class="demo-table">
            <div class="demo-row demo-row-head font-mono text-xs">
              <div class="col-claim">Target Commercial Claim</div>
              <div class="col-status">Evidentiary Status</div>
              <div class="col-finding">Verified Audit Finding</div>
            </div>

            {demoFindings.map((row) => (
              <div class="demo-row">
                <div class="col-claim text-sm text-primary font-medium">"{row.claim}"</div>
                <div class="col-status">
                  <span class={`status-pill font-mono text-xs ${row.badgeClass}`}>{row.status}</span>
                </div>
                <div class="col-finding text-xs text-secondary leading-relaxed">{row.finding}</div>
              </div>
            ))}
          </div>

          <div class="demo-footer font-mono text-xs text-muted">
            <span>SYNTHETIC DEMONSTRATION DELIVERABLE: 151 Paragraphs, 57 Tables in Branded Microsoft Word (.docx) Format with Full Citation Registers</span>
          </div>
        </div>
      </div>
    </section>

    {/* 5. Separate Human-Led Research Services */}
    <section class="intel-services" id="services">
      <div class="grid-container">
        <div class="section-lead">
          <span class="section-kicker font-mono text-xs text-muted font-bold">INVESTIGATIVE PRACTICE</span>
          <h2 class="section-title font-display">Human-Led Research Services</h2>
          <p class="section-desc text-secondary text-sm leading-relaxed">
            Confidential public-record investigations conducted by experienced analysts to support complex commercial decisions.
          </p>
        </div>

        <div class="services-grid">
          {humanServices.map((srv) => (
            <div class="service-item panel-telemetry">
              <h3 class="service-title font-display">{srv.title}</h3>
              <p class="service-desc text-secondary text-sm leading-relaxed">{srv.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 6. Developer & Agent Integration (Open Integration) */}
    <section class="intel-developer" id="technology">
      <div class="grid-container">
        <div class="developer-panel panel-telemetry">
          <div class="developer-content">
            <span class="font-mono text-xs text-emerald font-bold">SYSTEM INTEGRATION</span>
            <h2 class="developer-title font-display">Built for Analysts and AI Agents</h2>
            <p class="developer-desc text-secondary text-sm leading-relaxed">
              Agletras Intelligence connects with compatible AI agents using the open Model Context Protocol (MCP) over standard I/O (stdio). This connection allows autonomous tools and investigative agents to query indexed evidence, examine preserved passages, and verify findings directly within their existing workflows.
            </p>
            <p class="developer-subtext text-secondary text-xs leading-relaxed">
              Local document extraction (PDF, Office, text), passage fingerprinting, SQLite storage, and deterministic verification checks execute locally on your workstation by default. External network access is strictly bounded: public web search uses configured endpoints with SSRF guards blocking private networks, and optional external model endpoints only transmit data if explicitly configured in settings.
            </p>
            <div class="developer-actions">
              <a href="https://github.com/Agletras/Agletras-mcp.git" target="_blank" rel="noopener noreferrer" class="link-github font-mono text-xs text-emerald">
                <span>View open source on GitHub &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 7. Contact CTA */}
    <section class="intel-contact">
      <div class="grid-container">
        <div class="contact-panel panel-telemetry">
          <div class="contact-inner">
            <h2 class="contact-title font-display">Make Decisions with Verified Evidence</h2>
            <p class="contact-desc text-secondary text-sm leading-relaxed">
              Whether you need automated research infrastructure or confidential corporate investigations, discuss your requirements with our team.
            </p>
            <div class="contact-actions">
              <a href={paths.contact()} class="btn-primary">
                <span>Contact Our Team</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intelligence-page {
    padding-top: 80px;
    padding-bottom: 96px;
    background-color: var(--bg-deep);
  }

  /* Shared Panels */
  .panel-telemetry {
    background: rgba(6, 14, 10, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 32px 28px;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .panel-telemetry:hover {
    border-color: var(--border-active);
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.04);
  }

  /* Section Lead */
  .section-lead {
    grid-column: span 32;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section-kicker {
    letter-spacing: 0.12em;
    font-size: 0.68rem;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .section-desc {
    max-width: 720px;
    line-height: 1.6;
  }

  /* 1. Hero / Intro */
  .intel-hero {
    padding: 72px 0 88px;
    border-bottom: 1px solid var(--border-hairline);
  }

  .hero-content {
    grid-column: 1 / span 28;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero-intro {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    max-width: 820px;
    line-height: 1.65;
  }

  .hero-subtext {
    max-width: 760px;
    line-height: 1.6;
  }

  /* 2. Capabilities (Three clean customer cards) */
  .intel-capabilities {
    padding: 80px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .capabilities-grid {
    grid-column: span 32;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .capability-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .capability-num {
    letter-spacing: 0.1em;
  }

  .capability-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .capability-desc {
    line-height: 1.6;
  }

  /* 3. Workflow */
  .intel-workflow {
    padding: 80px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .workflow-steps {
    grid-column: span 32;
    display: flex;
    align-items: stretch;
    gap: 12px;
  }

  .workflow-step {
    flex: 1;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .step-num {
    letter-spacing: 0.1em;
    font-size: 0.65rem;
  }

  .step-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .step-desc {
    line-height: 1.55;
  }

  .workflow-arrow {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    font-size: 1.2rem;
    padding: 0 4px;
  }

  /* 4. Genuine Product Demonstration */
  .intel-demo {
    padding: 80px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .demo-panel {
    grid-column: span 32;
    padding: 0;
    overflow: hidden;
  }

  .demo-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 28px;
    background: rgba(16, 185, 129, 0.05);
    border-bottom: 1px solid var(--border-hairline);
  }

  .demo-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-green-bright);
    letter-spacing: 0.08em;
  }

  .demo-label {
    letter-spacing: 0.08em;
  }

  .demo-table {
    display: flex;
    flex-direction: column;
  }

  .demo-row {
    display: grid;
    grid-template-columns: 2fr 1.2fr 2.8fr;
    gap: 20px;
    align-items: center;
    padding: 20px 28px;
    border-bottom: 1px solid var(--border-hairline);
  }

  .demo-row:last-child {
    border-bottom: none;
  }

  .demo-row-head {
    background: rgba(3, 7, 5, 0.5);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 14px 28px;
  }

  .status-pill {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 2px;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    font-weight: 700;
  }

  .badge-supported {
    background: rgba(16, 185, 129, 0.15);
    color: var(--brand-green-bright);
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .badge-conflict {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.4);
  }

  .badge-contradicted {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .demo-footer {
    padding: 16px 28px;
    background: rgba(3, 7, 5, 0.4);
    border-top: 1px solid var(--border-hairline);
    letter-spacing: 0.05em;
  }

  /* 5. Services */
  .intel-services {
    padding: 80px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .services-grid {
    grid-column: span 32;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .service-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* 6. Developer / Open Integration */
  .intel-developer {
    padding: 80px 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .developer-panel {
    grid-column: span 32;
    padding: 48px 40px;
    background: rgba(6, 14, 10, 0.45);
  }

  .developer-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .developer-title {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: var(--text-primary);
  }

  .developer-desc {
    line-height: 1.65;
  }

  .developer-subtext {
    line-height: 1.6;
  }

  .developer-actions {
    margin-top: 8px;
  }

  .link-github {
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color var(--transition-fast);
  }

  .link-github:hover {
    color: var(--brand-green-bright);
    text-decoration: underline;
  }

  /* 7. Contact CTA */
  .intel-contact {
    padding: 80px 0 30px;
  }

  .contact-panel {
    grid-column: 1 / span 32;
    padding: 56px 48px;
    background: linear-gradient(135deg, rgba(6, 78, 59, 0.25) 0%, rgba(6, 14, 10, 0.8) 100%);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .contact-inner {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact-title {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 800;
    color: var(--text-primary);
  }

  .contact-actions {
    margin-top: 10px;
  }

  /* Responsive & Refined Mobile Spacing */
  @media (max-width: 1024px) {
    .hero-content {
      grid-column: span 32;
    }
    .capabilities-grid {
      grid-template-columns: 1fr;
    }
    .workflow-steps {
      flex-direction: column;
    }
    .workflow-arrow {
      justify-content: center;
      transform: rotate(90deg);
      padding: 6px 0;
    }
    .demo-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .demo-row-head {
      display: none;
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .developer-panel {
      padding: 32px 24px;
    }
  }

  @media (max-width: 768px) {
    .intelligence-page {
      padding-top: 60px;
      padding-bottom: 60px;
    }
    .intel-hero {
      padding: 40px 0 48px;
    }
    .hero-content {
      gap: 16px;
    }
    .hero-headline {
      font-size: 2.1rem;
    }
    .hero-intro {
      font-size: 1.05rem;
      line-height: 1.55;
    }
    .intel-capabilities,
    .intel-workflow,
    .intel-demo,
    .intel-services,
    .intel-developer {
      padding: 44px 0;
    }
    .capabilities-grid,
    .services-grid {
      gap: 16px;
    }
    .panel-telemetry {
      padding: 24px 20px;
    }
    .section-lead {
      margin-bottom: 20px;
    }
    .section-title {
      font-size: 1.6rem;
    }
    .intel-contact {
      padding: 44px 0 20px;
    }
    .contact-panel {
      padding: 28px 20px;
    }
    .contact-inner {
      gap: 14px;
    }
    .contact-title {
      font-size: 1.6rem;
    }
  }
</style>
