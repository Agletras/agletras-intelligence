---
import BaseLayout from '@/components/layout/BaseLayout.astro'
import TerminalSimulator from '@/components/product/TerminalSimulator.astro'
import AgentSnippets from '@/components/product/AgentSnippets.astro'
import McpToolDirectory from '@/components/product/McpToolDirectory.astro'
import { paths } from '@/lib/routes'
---

<BaseLayout
  title="Agletras Intelligence — AI-Native Research Platform & MCP Server"
  description="Agletras Intelligence connects AI agents to structured research workflows, multi-source evidence ingestion, passage indexing, claim verification and citation-backed reporting through a standardized Model Context Protocol interface."
  currentPath="/"
>
  <div class="product-home">
    {/* SECTION 1: Product-Focused Technology Hero */}
    <section class="hero-section" id="hero">
      <div class="grid-container">
        <div class="hero-col">
          <div class="hero-badge font-mono text-xs">
            <span class="beacon-dot"></span>
            <span class="text-emerald font-bold">AGLETRAS INTELLIGENCE // AI-NATIVE RESEARCH INFRASTRUCTURE &amp; MCP SERVER</span>
          </div>

          <h1 class="hero-headline font-display">
            Turn AI Agents Into Evidence-Driven Research Systems.
          </h1>

          <p class="hero-subhead text-secondary leading-relaxed">
            Agletras Intelligence connects AI agents to structured research workflows, multi-source evidence ingestion, passage indexing, claim verification and citation-backed reporting through a standardized Model Context Protocol interface.
          </p>

          <!-- Foundational Epistemic Principle Strip -->
          <div class="hero-epistemic-quote font-mono text-xs">
            <span class="text-emerald font-bold">CORE STANDARD:</span>
            <span class="text-secondary">"Intelligence is only as strong as its evidence."</span>
            <span class="text-muted">— Every statement requires verifiable passage locators.</span>
          </div>

          <!-- Hero Action CTAs -->
          <div class="hero-actions">
            <a href="#mcp" class="btn-primary" id="btn-explore-arch">
              <span>Explore the Architecture</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="https://github.com/Agletras/Agletras-mcp.git" target="_blank" rel="noopener noreferrer" class="btn-secondary" id="btn-view-github">
              <span>View on GitHub ★</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#cockpit" class="btn-explore font-mono text-xs text-emerald" id="btn-explore-cockpit">
              <span>Explore the Live Demonstration ↓</span>
            </a>
          </div>

          <!-- Quick Telemetry Pill -->
          <div class="hero-telemetry-pill panel-telemetry font-mono text-xs">
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="text-emerald font-bold">40 TOOLS</span>
              <span class="text-muted">REGISTERED MCP PROTOCOL</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="text-emerald font-bold">NO MANDATORY PAID API KEYS</span>
              <span class="text-muted">FOR CORE OPERATION</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="text-emerald font-bold">SQLITE WAL</span>
              <span class="text-muted">LOCAL-FIRST EVIDENCE</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="text-emerald font-bold">SHA-256</span>
              <span class="text-muted">CHANGE DETECTION</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 2: Show the Actual Working Project — Interactive Research Cockpit */}
    <section class="demo-section" id="cockpit">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            SIMULATED PIPELINE DEMONSTRATION // WORKING PROJECT
          </div>
          <h2 class="section-title font-display">Interactive Research Cockpit</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Inspect an illustrative execution trace showing how Agletras Intelligence bounds subquestions, fetches multi-format sources with outbound SSRF protection, indexes passages with exact character offsets, and verifies claims into explicit epistemic states via standard MCP integration. All displayed timings, sample entities, and passage counts are simulated examples.
          </p>
        </div>

        <div class="demo-wrapper">
          <TerminalSimulator />
        </div>
      </div>
    </section>

    {/* SECTION 3: Agletras Intelligence Architecture */}
    <section class="mcp-section" id="mcp">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            AGLETRAS INTELLIGENCE // RESEARCH ARCHITECTURE
          </div>
          <h2 class="section-title font-display">Connect AI Agents to Evidence-Driven Intelligence</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Agletras Intelligence exposes a standardized Model Context Protocol (MCP) server that connects frontier models directly to local-first evidence pipelines. Through 40 registered MCP tools, agents can orchestrate investigations, retrieve multi-format sources, index passages, and verify factual claims through evidence-backed claim verification. Public web search and URL retrieval require internet access with strict outbound SSRF protections, while parsing, evidence indexing, and claim verification run entirely locally with zero mandatory paid APIs.
          </p>
        </div>

        <div class="mcp-capabilities-grid">
          <!-- Suite 1: Source Ingestion -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">01 // INGESTION</span>
              <span class="suite-badge font-mono text-xs text-muted">13 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Multi-Source Ingestion &amp; Extraction</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Equips agents with <code>search_web</code>, <code>fetch_url</code>, <code>extract_pdf</code>, <code>extract_document</code> (DOCX/XLSX/CSV), and <code>collect_local_folder</code>. Public web retrieval requires internet access, guarded by outbound NetPolicy blocking loopback, RFC1918 private IPs, and cloud metadata.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>search_web · fetch_url · extract_pdf · collect_sources · extract_document</span>
            </div>
          </div>

          <!-- Suite 2: Evidence Library -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">02 // EVIDENCE</span>
              <span class="suite-badge font-mono text-xs text-muted">9 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Content-Addressed Evidence Store</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Every source undergoes change detection through SHA-256 content hashing in local SQLite WAL storage. Text is segmented into deterministic passage slices with exact character offsets and page locators. Searchable via SQLite FTS5 with citations pointing to exact verified text.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>start_research_run · save_evidence · search_evidence · attach_citation</span>
            </div>
          </div>

          <!-- Suite 3: Epistemic Verification -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">03 // VERIFICATION</span>
              <span class="suite-badge font-mono text-xs text-muted">5 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Claim Extraction &amp; Epistemic Engine</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Extracts factual statements and maps them to exact passage locators. Evaluates claims into 6 unambiguous epistemic states: <code>SUPPORTED</code>, <code>PARTIALLY SUPPORTED</code>, <code>CONTRADICTED</code>, <code>CONFLICTING EVIDENCE</code>, <code>UNSUPPORTED</code>, and <code>UNVERIFIABLE</code>.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>extract_claims · verify_claims · analyze_conflicts · validate_report</span>
            </div>
          </div>

          <!-- Suite 4: Autonomous Planner & Delivery -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">04 // ORCHESTRATION</span>
              <span class="suite-badge font-mono text-xs text-muted">13 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Autonomous Planner &amp; Client Reports</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Orchestrates primary OpenCode research agents under bounded execution budgets (subquestions, rounds, candidate caps). Renders 10-section Markdown synthesis reports and automatically populates validated corporate DOCX deliverable packages.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>save_research_plan · finish_research_run · generate_client_report · monitor_changes</span>
            </div>
          </div>
        </div>

        <!-- Protocol Technical Architecture Banner -->
        <div class="protocol-spec-banner panel-telemetry">
          <div class="protocol-col">
            <span class="protocol-kicker font-mono text-xs text-emerald font-bold">FOUNDATIONAL EPISTEMIC STANDARD</span>
            <p class="protocol-quote text-secondary text-sm">
              Intelligence is only as strong as its evidence. Agletras Intelligence requires exact citations, transparent source quality disclosures, and honest derived epistemic statuses for well-supported findings.
            </p>
          </div>
          <div class="protocol-meta font-mono text-xs text-muted">
            <div class="proto-row"><span>TRANSPORT:</span> <span class="text-emerald">Standard Stdio (JSON-RPC 2.0)</span></div>
            <div class="proto-row"><span>DEPENDENCIES:</span> <span class="text-emerald">Zero New Runtime Deps (Stdlib + pypdf)</span></div>
            <div class="proto-row"><span>CLIENTS:</span> <span class="text-emerald">OpenCode · Claude Desktop · Cursor · CLI</span></div>
          </div>
        </div>

        <!-- Verified 40-Tool MCP Directory Grounded in Code -->
        <McpToolDirectory />
      </div>
    </section>

    {/* SECTION 4: Verified Capabilities (The 4 Pillars) */}
    <section class="capabilities-section" id="capabilities">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            ENGINEERING SPECIFICATIONS
          </div>
          <h2 class="section-title font-display">Four Architectural Pillars Grounded in Code</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Agletras Intelligence operates with a local-first storage architecture, zero mandatory paid APIs for core operation, and deterministic standard library logic. Public web retrieval requires internet access with strict SSRF controls, while local data is content-hashed for change detection.
          </p>
        </div>

        <div class="capabilities-grid">
          <!-- Pillar 1 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">01 // INGESTION</span>
              <span class="cap-tag font-mono text-xs text-muted">SSRF-GUARDED</span>
            </div>
            <h3 class="cap-title font-display">Multi-Format Research Ingestion</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Paced web search via DuckDuckGo and Wikipedia without API keys. Outbound retrieval requires public internet access, guarded by strict private-IP and metadata blocking. Direct text extraction from PDF (<code>pypdf</code>), DOCX/XLSX (stdlib <code>zipfile</code> + <code>xml.etree</code>), CSV, and local directories with path containment.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Outbound NetPolicy: RFC1918 &amp; Loopback Blocked</span>
            </div>
          </div>

          <!-- Pillar 2 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">02 // EVIDENCE</span>
              <span class="cap-tag font-mono text-xs text-muted">CONTENT-HASHED</span>
            </div>
            <h3 class="cap-title font-display">Content-Addressed Evidence Store</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Every collected source undergoes change detection through SHA-256 content hashing and is stored in local SQLite WAL mode. Text is segmented into deterministic passage slices with exact character offsets and page locators. Citations must point to exact, verified passage text.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>SQLite FTS5 Full-Text Passage Search</span>
            </div>
          </div>

          <!-- Pillar 3 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">03 // PLANNER</span>
              <span class="cap-tag font-mono text-xs text-muted">BOUNDED BUDGET</span>
            </div>
            <h3 class="cap-title font-display">Bounded Autonomous Orchestrator</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Enforces bounded execution budgets on autonomous agents: max 8 subquestions, max 2 follow-up rounds, max 4 candidates per question, and max 20 sources per run. Stop conditions enforce budget limits to prevent runaway execution.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Append-Only SQLite Execution Log</span>
            </div>
          </div>

          <!-- Pillar 4 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">04 // VERIFICATION</span>
              <span class="cap-tag font-mono text-xs text-muted">EPISTEMIC ENGINE</span>
            </div>
            <h3 class="cap-title font-display">Six-State Epistemic Verification</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Evaluates factual statements against exact passage text into 6 unambiguous states: <code>SUPPORTED</code>, <code>PARTIALLY SUPPORTED</code>, <code>CONTRADICTED</code>, <code>CONFLICTING EVIDENCE</code>, <code>UNSUPPORTED</code>, <code>UNVERIFIABLE</code>. Exposes disagreements without resolving them by preference.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Deterministic Conflict &amp; Disagreement Surfacing</span>
            </div>
          </div>
        </div>

        <!-- Telemetry Statistics Strip -->
        <div class="telemetry-strip panel-telemetry font-mono text-xs">
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">40</span>
            <span class="stat-label text-muted">REGISTERED MCP TOOLS</span>
          </div>
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">0</span>
            <span class="stat-label text-muted">PAID API KEYS FOR CORE OPERATION</span>
          </div>
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">LOCAL-FIRST</span>
            <span class="stat-label text-muted">EVIDENCE STORAGE (SQLITE WAL)</span>
          </div>
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">SHA-256</span>
            <span class="stat-label text-muted">CONTENT HASHING &amp; CHANGE DETECTION</span>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 5: Developer Quickstart & Agent Integrations */}
    <section class="quickstart-section" id="quickstart">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            AGENT HARNESS CONFIGURATION &amp; INSTALLATION
          </div>
          <h2 class="section-title font-display">Connect to Your Preferred Agent Harness</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Agletras Intelligence connects via standard Model Context Protocol (stdio) or runs standalone via Python CLI. Connect it directly to OpenCode, Claude Desktop, Cursor, or install it locally.
          </p>
        </div>

        <!-- Quickstart Installation Command Box -->
        <div class="quickstart-install-wrap">
          <div class="install-header font-mono text-xs text-muted">
            <span>REPOSITORY INSTALLATION // PYTHON 3.11+</span>
          </div>
          <div class="hero-install-box">
            <div class="install-line">
              <span class="prompt-sym font-mono text-emerald">$</span>
              <code class="install-code font-mono text-sm" id="hero-install-cmd">git clone https://github.com/Agletras/Agletras-mcp.git &amp;&amp; cd Agletras-mcp &amp;&amp; pip install -e .</code>
            </div>
            <button type="button" class="btn-copy-install font-mono text-xs" id="btn-copy-hero-cmd" aria-label="Copy installation command">
              <span class="copy-txt">Copy</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="quickstart-wrapper">
          <AgentSnippets />
        </div>
      </div>
    </section>

    {/* SECTION 6: Five-Stage Research Workflow */}
    <section class="workflow-section" id="workflow">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            EXECUTION PIPELINE
          </div>
          <h2 class="section-title font-display">The Five-Stage Research Workflow</h2>
          <p class="section-desc text-secondary leading-relaxed">
            How autonomous agents advance an inquiry from initial hypothesis to validated findings and delivery packages.
          </p>
        </div>

        <div class="workflow-steps-grid">
          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 01</div>
            <h3 class="step-title font-display">Plan &amp; Bound</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Formulate 3–8 targeted subquestions, establish scope, and set strict source budgets to bound execution.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 02</div>
            <h3 class="step-title font-display">Multi-Source Ingest</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Collect web pages, PDFs, and local documents through SSRF-guarded fetchers with automatic format routing.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 03</div>
            <h3 class="step-title font-display">Passage Indexing</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Segment text into deterministic character slices with SHA-256 hashes, page locators, and FTS5 search indexing.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 04</div>
            <h3 class="step-title font-display">Claim Verification</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Extract candidate statements and compare them against stored passage text to derive explicit epistemic statuses.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 05</div>
            <h3 class="step-title font-display">Synthesis &amp; Delivery</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Render 10-section Markdown synthesis reports and populate corporate DOCX packages with citation and structural report validation.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 7: Commercial Advisory Practice — Human-Led Research */}
    <section class="human-led-section" id="human-led">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            COMMERCIAL ADVISORY PRACTICE // EXECUTIVE INVESTIGATIONS
          </div>
          <h2 class="section-title font-display">Human-Led Research</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Lawful, human-led corporate investigations conducted by experienced intelligence analysts to support critical business decisions, counterparty evaluations, executive vetting, and strategic risk management.
          </p>
        </div>

        <div class="human-led-grid">
          <div class="practice-card panel-telemetry">
            <div class="practice-tag font-mono text-xs text-muted font-bold">DILIGENCE</div>
            <h3 class="practice-title font-display">Partner &amp; Company Checks</h3>
            <p class="practice-desc text-secondary text-sm leading-relaxed">
              Rigorous public-record evaluations of prospective commercial counterparties, suppliers, and acquisition targets before signing binding agreements.
            </p>
          </div>

          <div class="practice-card panel-telemetry">
            <div class="practice-tag font-mono text-xs text-muted font-bold">LINEAGE</div>
            <h3 class="practice-title font-display">Ownership &amp; Relationships</h3>
            <p class="practice-desc text-secondary text-sm leading-relaxed">
              Systematic tracing of corporate shareholding networks, parent entities, holding jurisdictions, and ultimate beneficial ownership structures.
            </p>
          </div>

          <div class="practice-card panel-telemetry">
            <div class="practice-tag font-mono text-xs text-muted font-bold">VETTING</div>
            <h3 class="practice-title font-display">Leadership Backgrounds</h3>
            <p class="practice-desc text-secondary text-sm leading-relaxed">
              Verifying executive credentials, past corporate directorships, regulatory compliance records, and public digital exposure.
            </p>
          </div>

          <div class="practice-card panel-telemetry">
            <div class="practice-tag font-mono text-xs text-muted font-bold">SECURITY</div>
            <h3 class="practice-title font-display">Online Threats &amp; Impersonation</h3>
            <p class="practice-desc text-secondary text-sm leading-relaxed">
              Investigating external digital threats, fraudulent domain registrations, brand cloning, and rogue counterparties targeting your organization.
            </p>
          </div>
        </div>

        <div class="practice-action-box panel-telemetry">
          <div class="action-info">
            <h3 class="action-h3 font-display">Commission a Scoped Corporate Investigation</h3>
            <p class="action-p text-secondary text-sm">
              All investigations strictly observe our non-intrusion charter using lawful public records. Discuss your scope with our intelligence team.
            </p>
            <div class="intake-mail font-mono text-xs text-emerald">
              Official Intake Channel: <a href="mailto:info.agletras@gmail.com" class="underline">info.agletras@gmail.com</a>
            </div>
          </div>
          <div class="action-btn-wrap">
            <a href={paths.contact()} class="btn-primary">
              <span>Contact Our Practice</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 8: Documentation, Open Source and Corporate Contact */}
    <section class="docs-cta-section" id="docs">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            RESOURCES &amp; INQUIRY ROUTING
          </div>
          <h2 class="section-title font-display">Documentation, Open Source &amp; Inquiries</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Explore the complete technical specifications, review the open Python codebase on GitHub, or submit a scoping brief directly to our analytical team.
          </p>
        </div>

        <div class="docs-grid">
          <div class="cta-card panel-telemetry">
            <div class="cta-tag font-mono text-xs text-emerald font-bold">SPECIFICATIONS</div>
            <h3 class="cta-title font-display">Agletras Technical Reference</h3>
            <p class="cta-desc text-secondary text-sm leading-relaxed">
              Read the complete reference documentation for all 40 registered MCP tools, input schemas, SSRF network policies, and epistemic verification standards.
            </p>
            <div class="cta-btn-row">
              <a href={paths.intelligence()} class="btn-primary">
