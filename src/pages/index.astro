---
import BaseLayout from '@/components/layout/BaseLayout.astro'
import TerminalSimulator from '@/components/product/TerminalSimulator.astro'
import McpToolDirectory from '@/components/product/McpToolDirectory.astro'
import InteractiveArchitecture from '@/components/product/InteractiveArchitecture.astro'
import SecurityPrivacyMatrix from '@/components/product/SecurityPrivacyMatrix.astro'
import ProductRoadmap from '@/components/product/ProductRoadmap.astro'
import DeveloperOnboarding from '@/components/docs/DeveloperOnboarding.astro'
import IntegrationShowcase from '@/components/docs/IntegrationShowcase.astro'
import TechnicalDocumentation from '@/components/docs/TechnicalDocumentation.astro'
import GithubDeepDive from '@/components/docs/GithubDeepDive.astro'
import { paths, withBase } from '@/lib/routes'
---

<BaseLayout
  title="Agletras Intelligence — AI-Native Research Platform & MCP Server"
  description="Agletras Intelligence connects AI agents to structured research workflows, multi-source evidence ingestion, passage indexing, claim verification and citation-backed reporting through a standardized Model Context Protocol interface."
  currentPath="/"
>
  <div class="product-home">
    {/* SECTION 1: Product-Focused Technology Hero */}
    <section class="hero-section" id="hero">
      {/* Cinematic Underwater Algae Video Backdrop */}
      <div class="hero-video-backdrop" aria-hidden="true">
        <video
          id="hero-bg-video"
          class="hero-video-media"
          autoplay
          loop
          muted
          playsinline
          webkit-playsinline="true"
          preload="auto"
          poster={withBase('/hero-algae-poster.jpg')}
        >
          <source src={withBase('/hero-algae.mp4')} type="video/mp4" />
        </video>
        <img
          class="hero-fallback-poster"
          src={withBase('/hero-algae-poster.jpg')}
          alt=""
          loading="eager"
          decoding="async"
        />
        <div class="hero-caustics-shimmer" aria-hidden="true"></div>
        <div class="hero-video-overlay"></div>
        <div class="hero-spotlight-glow" aria-hidden="true"></div>
      </div>
      <script is:inline>
        (() => {
          const v = document.getElementById('hero-bg-video');
          if (v) {
            const ensurePlay = () => {
              if (v.paused) {
                v.play().catch(() => {});
              }
            };
            ensurePlay();
            document.addEventListener('visibilitychange', () => {
              if (!document.hidden) ensurePlay();
            });
            window.addEventListener('pointerdown', ensurePlay, { once: true });
          }
        })();
      </script>

      <div class="hero-ambient-glow" aria-hidden="true"></div>
      <div class="grid-container">
        <div class="hero-col">
          <div class="hero-badge font-mono text-xs">
            <span class="beacon-dot"></span>
            <span class="text-emerald font-bold">AGLETRAS INTELLIGENCE // AI-NATIVE RESEARCH INFRASTRUCTURE &amp; MCP SERVER</span>
          </div>

          <h1 class="hero-headline font-display">
            Turn AI Agents Into Evidence-Driven Research Systems.
          </h1>

          <p class="hero-subhead text-secondary leading-relaxed">
            Agletras Intelligence is an open-source, local-first Model Context Protocol (MCP) server that connects frontier AI agents to structured, bounded multi-source research pipelines, SQLite WAL evidence indexing, and automated epistemic claim verification with zero mandatory paid APIs.
          </p>

          <!-- System Status & Specification Strip -->
          <div class="hero-telemetry-pill panel-telemetry text-xs">
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="font-mono text-emerald font-bold">v0.2.0 SPECIFICATION</span>
              <span class="text-muted">MCP PROTOCOL 2024-11-05</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="font-mono text-emerald font-bold">NATIVE STDIO</span>
              <span class="text-muted">JSON-RPC 2.0 PROTOCOL</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="font-mono text-emerald font-bold">40 TOOLS // 6 SUITES</span>
              <span class="text-muted">ZERO PAID API KEYS FOR CORE</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="font-mono text-emerald font-bold">SQLITE WAL</span>
              <span class="text-muted">LOCAL-FIRST STORE &amp; FTS5</span>
            </div>
            <div class="pill-divider" aria-hidden="true">/</div>
            <div class="pill-item">
              <span class="pill-dot"></span>
              <span class="font-mono text-emerald font-bold">NETPOLICY</span>
              <span class="text-muted">RFC1918 &amp; CLOUD METADATA BLOCKED</span>
            </div>
          </div>

          <!-- Foundational Epistemic Principle Strip -->
          <div class="hero-epistemic-quote text-xs">
            <span class="hero-quote-badge font-mono text-emerald font-bold">CORE STANDARD</span>
            <span class="text-primary font-medium">"Intelligence is only as strong as its evidence."</span>
            <span class="text-muted">— Every statement requires verifiable passage locators.</span>
          </div>

          <!-- Hero Action CTAs -->
          <div class="hero-actions">
            <a href="#mcp" class="btn-primary" id="btn-explore-arch">
              <span>Explore Architecture &amp; NetPolicy</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="https://github.com/Agletras/Agletras-mcp.git" target="_blank" rel="noopener noreferrer" class="btn-secondary" id="btn-view-github">
              <span>View on GitHub ★</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#cockpit" class="btn-explore text-sm text-emerald font-medium" id="btn-explore-cockpit">
              <span>Explore Simulated Pipeline Demonstration ↓</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 2: Show the Actual Working Project — Interactive Research Cockpit */}
    <section class="demo-section reveal-on-scroll" id="cockpit">
      {/* Underwater Algae Ambient Spotlight Reveal Backdrop */}
      <div class="section-algae-backdrop" aria-hidden="true">
        <img
          class="section-algae-img"
          src={withBase('/hero-algae-poster.jpg')}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <div class="section-algae-overlay"></div>
        <div class="section-spotlight-glow"></div>
      </div>

      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            INTERACTIVE RESEARCH COCKPIT // SIMULATED PIPELINE DEMONSTRATION
          </div>
          <h2 class="section-title font-display">Interactive Research Cockpit</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Inspect an illustrative execution trace demonstrating how Agletras Intelligence bounds subquestions, fetches multi-format sources with outbound SSRF protection, indexes passages with exact character offsets, and verifies claims into explicit epistemic states via standard MCP integration. All displayed timings, sample entities, and passage counts are simulated examples demonstrating actual tool capabilities, not live server execution.
          </p>
        </div>

        <div class="demo-wrapper">
          <TerminalSimulator />
        </div>
      </div>
    </section>

    {/* SECTION 3: Agletras Intelligence Architecture */}
    <section class="mcp-section reveal-on-scroll" id="mcp">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            AGLETRAS INTELLIGENCE // RESEARCH ARCHITECTURE
          </div>
          <h2 class="section-title font-display">Connect AI Agents to Evidence-Driven Intelligence</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Agletras Intelligence exposes a standardized Model Context Protocol (MCP) server that connects frontier models directly to local-first evidence pipelines. Through 40 registered MCP tools across 6 suites, agents can orchestrate investigations, retrieve multi-format sources, index passages, and verify factual claims through evidence-backed claim verification. Public web search and URL retrieval require internet access with strict outbound SSRF protections, while parsing, evidence indexing, and claim verification run entirely locally with zero mandatory paid APIs.
          </p>
        </div>

        {/* Interactive 5-Tier Architecture Visualization Grounded in Code */}
        <div class="arch-wrapper">
          <InteractiveArchitecture />
        </div>

        <div class="mcp-capabilities-grid">
          <!-- Suite 1: Source Ingestion -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">01 // INGESTION</span>
              <span class="suite-badge font-mono text-xs text-muted">13 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Multi-Source Ingestion &amp; Extraction</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Equips agents with <code>search_web</code>, <code>fetch_url</code>, <code>extract_pdf</code>, <code>extract_document</code> (DOCX/XLSX/CSV), and <code>collect_local_folder</code>. Public web retrieval requires internet access, guarded by outbound NetPolicy blocking loopback, RFC1918 private IPs, and cloud metadata.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>search_web · fetch_url · extract_pdf · collect_sources · extract_document</span>
            </div>
          </div>

          <!-- Suite 2: Evidence Library -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">02 // EVIDENCE</span>
              <span class="suite-badge font-mono text-xs text-muted">9 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Content-Addressed Evidence Store</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Every source undergoes change detection through SHA-256 content hashing in local SQLite WAL storage. Text is segmented into deterministic passage slices with exact character offsets and page locators. Searchable via SQLite FTS5 with citations pointing to exact verified text.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>start_research_run · save_evidence · search_evidence · attach_citation</span>
            </div>
          </div>

          <!-- Suite 3: Epistemic Verification -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">03 // VERIFICATION</span>
              <span class="suite-badge font-mono text-xs text-muted">5 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Claim Extraction &amp; Epistemic Engine</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Extracts factual statements and maps them to exact passage locators. Evaluates claims into 6 unambiguous epistemic states: <code>SUPPORTED</code>, <code>PARTIALLY SUPPORTED</code>, <code>CONTRADICTED</code>, <code>CONFLICTING EVIDENCE</code>, <code>UNSUPPORTED</code>, and <code>UNVERIFIABLE</code>.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>extract_claims · verify_claims · analyze_conflicts · validate_report</span>
            </div>
          </div>

          <!-- Suite 4: Autonomous Orchestration & Planning -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">04 // ORCHESTRATION</span>
              <span class="suite-badge font-mono text-xs text-muted">7 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Autonomous Orchestration &amp; Planning</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Orchestrates primary OpenCode research agents under bounded execution budgets (subquestions, rounds, candidate caps). Enforces stopping rationale, logs immutable audit events, and automatically populates validated corporate DOCX deliverable packages.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>save_research_plan · update_subquestion · log_run_event · finish_research_run</span>
            </div>
          </div>

          <!-- Suite 5: Continuous Monitoring & Project Memory -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">05 // MEMORY</span>
              <span class="suite-badge font-mono text-xs text-muted">4 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Continuous Monitoring &amp; Project Memory</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Recalls verified evidence and findings across historical research runs. Registers web pages and file targets for periodic change detection checks with SHA-256 diff hashing and historical modification tracking.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>search_memory · monitor_add_target · monitor_check · monitor_changes</span>
            </div>
          </div>

          <!-- Suite 6: Visual Analysis & Image Research -->
          <div class="mcp-suite-card panel-telemetry">
            <div class="suite-header">
              <span class="suite-num font-mono text-xs text-emerald font-bold">06 // VISUAL ANALYSIS</span>
              <span class="suite-badge font-mono text-xs text-muted">2 TOOLS</span>
            </div>
            <h3 class="suite-title font-display">Visual Analysis &amp; Image Research</h3>
            <p class="suite-desc text-secondary text-sm leading-relaxed">
              Queries visual source metadata for candidate discovery across research targets. Performs visual analysis and OCR extraction via local image paths or optional external vision endpoints without breaking local-first workflows.
            </p>
            <div class="suite-tools font-mono text-xs text-dim">
              <span>search_images · analyze_image</span>
            </div>
          </div>
        </div>

        <!-- Protocol Technical Architecture Banner -->
        <div class="protocol-spec-banner panel-telemetry">
          <div class="protocol-col">
            <span class="protocol-kicker font-mono text-xs text-emerald font-bold">FOUNDATIONAL EPISTEMIC STANDARD</span>
            <p class="protocol-quote text-secondary text-sm">
              Intelligence is only as strong as its evidence. Agletras Intelligence requires exact citations, transparent source quality disclosures, and honest derived epistemic statuses for well-supported findings.
            </p>
          </div>
          <div class="protocol-meta font-mono text-xs text-muted">
            <div class="proto-row"><span>TRANSPORT:</span> <span class="text-emerald">Standard Stdio (JSON-RPC 2.0)</span></div>
            <div class="proto-row"><span>DEPENDENCIES:</span> <span class="text-emerald">Zero New Runtime Deps (Stdlib + pypdf)</span></div>
            <div class="proto-row"><span>CLIENTS:</span> <span class="text-emerald">OpenCode · Claude Desktop · Cursor · CLI</span></div>
          </div>
        </div>

        <!-- Verified 40-Tool MCP Directory Grounded in Code -->
        <McpToolDirectory />

        <!-- Data Privacy, NetPolicy & Security Matrix Grounded in Code -->
        <SecurityPrivacyMatrix />
      </div>
    </section>

    {/* SECTION 4: Four Verified Investigative Use Cases */}
    <section class="capabilities-section reveal-on-scroll" id="capabilities">
      {/* Underwater Algae Ambient Spotlight Reveal Backdrop */}
      <div class="section-algae-backdrop" aria-hidden="true">
        <img
          class="section-algae-img"
          src={withBase('/hero-algae-poster.jpg')}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <div class="section-algae-overlay"></div>
        <div class="section-spotlight-glow"></div>
      </div>

      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            VERIFIED INVESTIGATIVE USE CASES
          </div>
          <h2 class="section-title font-display">Four Grounded Use Cases for Enterprise Intelligence</h2>
          <p class="section-desc text-secondary leading-relaxed">
            How autonomous agents and analytical teams deploy Agletras Intelligence across corporate entity tracing, executive vetting, digital threat mapping, and compliance verification with verifiable passage citations, character-offset anchors, and deterministic claim evaluation.
          </p>
        </div>

        <div class="capabilities-grid">
          <!-- Use Case 1 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">01 // DUE DILIGENCE</span>
              <span class="cap-tag font-mono text-xs text-muted">OWNERSHIP LINEAGE</span>
            </div>
            <h3 class="cap-title font-display">Corporate Entity &amp; Beneficial Ownership Diligence</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Autonomous agents bound multi-source inquiries across corporate registries, official gazettes, and cross-border holding networks. Extracts shareholder networks and ultimate beneficial ownership structures directly linked to verifiable primary filings.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Verified Tools: collect_sources · search_web · extract_pdf · save_evidence</span>
            </div>
          </div>

          <!-- Use Case 2 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">02 // VETTING</span>
              <span class="cap-tag font-mono text-xs text-muted">EXECUTIVE INTEGRITY</span>
            </div>
            <h3 class="cap-title font-display">Leadership Background &amp; Credential Verification</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Systematic evaluation of executive employment timelines, past directorships, regulatory compliance records, and public digital exposure. Deterministic number and date checks immediately flag timeline conflicts.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Verified Tools: extract_claims · verify_claims · analyze_conflicts</span>
            </div>
          </div>

          <!-- Use Case 3 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">03 // SECURITY</span>
              <span class="cap-tag font-mono text-xs text-muted">THREAT SURFACE</span>
            </div>
            <h3 class="cap-title font-display">Brand Impersonation &amp; Digital Attack Surface</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Investigate external digital threats, fraudulent lookalike domain registrations, and deceptive counterparties targeting your organization. Socket-level NetPolicy prevents SSRF pivots during threat intelligence gathering.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Verified Tools: fetch_url · search_web · monitor_add_target · monitor_changes</span>
            </div>
          </div>

          <!-- Use Case 4 -->
          <div class="cap-card panel-telemetry">
            <div class="cap-header">
              <span class="cap-num font-mono text-xs text-emerald font-bold">04 // COMPLIANCE</span>
              <span class="cap-tag font-mono text-xs text-muted">EVIDENTIARY PROVENANCE</span>
            </div>
            <h3 class="cap-title font-display">Regulatory &amp; Compliance Evidence Provenance</h3>
            <p class="cap-desc text-secondary text-sm leading-relaxed">
              Audit-ready evidentiary dossiers with unbroken citation chains for legal counsel, auditors, and compliance officers. Every assertion is tied to character offsets and SHA-256 hashes with zero dangling citations.
            </p>
            <div class="cap-footer font-mono text-xs text-dim">
              <span>Verified Tools: generate_markdown_report · generate_client_report · validate_report</span>
            </div>
          </div>
        </div>

        <!-- Telemetry Statistics Strip -->
        <div class="telemetry-strip panel-telemetry font-mono text-xs">
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">40</span>
            <span class="stat-label text-muted">REGISTERED MCP TOOLS</span>
          </div>
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">0</span>
            <span class="stat-label text-muted">PAID API KEYS FOR CORE OPERATION</span>
          </div>
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">LOCAL-FIRST</span>
            <span class="stat-label text-muted">EVIDENCE STORAGE (SQLITE WAL)</span>
          </div>
          <div class="telemetry-item">
            <span class="stat-num text-emerald font-bold">SHA-256</span>
            <span class="stat-label text-muted">CONTENT HASHING &amp; CHANGE DETECTION</span>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 5: Developer Quickstart & Agent Integrations */}
    <section class="quickstart-section reveal-on-scroll" id="quickstart">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            DEVELOPER ONBOARDING &amp; AGENT HARNESS INTEGRATION
          </div>
          <h2 class="section-title font-display">Fast-Track Onboarding &amp; Client Integration</h2>
          <p class="section-desc text-secondary leading-relaxed">
            Follow the 5-step journey to discover, install, configure, connect, and execute Agletras Intelligence v0.2.0. Connect directly via standard Model Context Protocol (stdio) or model-free CLI.
          </p>
        </div>

        <!-- 5-Stage Developer Journey: Discover -> Install -> Configure -> Connect -> Execute -->
        <DeveloperOnboarding />

        <!-- Verified Client Configurations & Wire Protocols -->
        <IntegrationShowcase />
      </div>
    </section>

    {/* SECTION 6: Five-Stage Research Workflow */}
    <section class="workflow-section reveal-on-scroll" id="workflow">
      {/* Underwater Algae Ambient Spotlight Reveal Backdrop */}
      <div class="section-algae-backdrop" aria-hidden="true">
        <img
          class="section-algae-img"
          src={withBase('/hero-algae-poster.jpg')}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <div class="section-algae-overlay"></div>
        <div class="section-spotlight-glow"></div>
      </div>

      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
            EXECUTION PIPELINE
          </div>
          <h2 class="section-title font-display">The Five-Stage Research Workflow</h2>
          <p class="section-desc text-secondary leading-relaxed">
            How autonomous agents advance an inquiry from initial hypothesis to validated findings and delivery packages.
          </p>
        </div>

        <div class="workflow-steps-grid">
          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 01</div>
            <h3 class="step-title font-display">Plan &amp; Bound</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Formulate 3–8 targeted subquestions, establish scope, and set strict source budgets to bound execution.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 02</div>
            <h3 class="step-title font-display">Multi-Source Ingest</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Collect web pages, PDFs, and local documents through SSRF-guarded fetchers with automatic format routing.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 03</div>
            <h3 class="step-title font-display">Passage Indexing</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Segment text into deterministic character slices with SHA-256 hashes, page locators, and FTS5 search indexing.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 04</div>
            <h3 class="step-title font-display">Claim Verification</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Extract candidate statements and compare them against stored passage text to derive explicit epistemic statuses.
            </p>
          </div>

          <div class="workflow-step panel-telemetry">
            <div class="step-num font-mono text-xs text-emerald font-bold">STAGE 05</div>
            <h3 class="step-title font-display">Synthesis &amp; Delivery</h3>
            <p class="step-desc text-secondary text-xs leading-relaxed">
              Render 10-section Markdown synthesis reports and populate corporate DOCX packages with citation and structural report validation.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 7: Commercial Advisory Practice — Human-Led Research */}
    <section class="human-led-section reveal-on-scroll" id="human-led">
      <div class="grid-container">
        <div class="section-header">
          <div class="eyebrow-tag font-mono text-xs text-emerald font-bold">
