<script>
  // Robust clipboard copy with fallback
  async function copyTextToClipboard(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text)
        return true
      }
    } catch {
      // fallback below
    }
    try {
      const textArea = document.createElement('textarea')
      textArea.value = text
      textArea.style.position = 'fixed'
      textArea.style.left = '-999999px'
      textArea.style.top = '-999999px'
      textArea.setAttribute('readonly', '')
      document.body.appendChild(textArea)
      textArea.select()
      const success = document.execCommand('copy')
      document.body.removeChild(textArea)
      return success
    } catch {
      return false
    }
  }

  // Copy button handler for hero install command
  const copyHeroBtn = document.getElementById('btn-copy-hero-cmd') as HTMLButtonElement | null
  const copyHeroTxt = copyHeroBtn ? copyHeroBtn.querySelector<HTMLElement>('.copy-txt') : null

  if (copyHeroBtn && copyHeroTxt) {
    copyHeroBtn.addEventListener('click', async () => {
      const cmdCode = document.getElementById('hero-install-cmd') as HTMLElement | null
      if (cmdCode) {
        const text = cmdCode.innerText || cmdCode.textContent || ''
        await copyTextToClipboard(text)
        const orig = copyHeroTxt.innerText || copyHeroTxt.textContent || ''
        copyHeroTxt.innerText = 'Copied!'
        copyHeroBtn.classList.add('is-copied')
        setTimeout(() => {
          copyHeroTxt.innerText = orig
          copyHeroBtn.classList.remove('is-copied')
        }, 2000)
      }
    })
  }

  // IntersectionObserver for smooth section scroll reveals
  if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
    const revealSections = document.querySelectorAll('.reveal-on-scroll')
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed')
          observer.unobserve(entry.target)
        }
      })
    }, {
      threshold: 0.08,
      rootMargin: '0px 0px -40px 0px'
    })

    revealSections.forEach((sec) => revealObserver.observe(sec))
  }
</script>

